// m58282 «Position, Displacement, and Average Velocity» — fs-id1168329394923
fragment UP_M58282_POSITION in M58282_MAIN {
    kind defn;
    locator "module/m58282#fs-id1168329394923";
    text en official """<definition id="fs-id1168329394923">
<term>position</term>
<meaning id="fs-id1168329181740">the location of an object at a particular time</meaning>
</definition>""";
    content_hash "sha256:70b53ce53d88b0a1ae9ed76b84fe7b6eb5a2d1f0403ddbcd4c1542bad4e2420a";
}

// m58282 «Position, Displacement, and Average Velocity» — fs-id1168329400874
fragment UP_M58282_DISPLACEMENT in M58282_MAIN {
    kind defn;
    locator "module/m58282#fs-id1168329400874";
    text en official """<definition id="fs-id1168329400874">
<term>displacement</term>
<meaning id="fs-id1168329511515">the change in position of an object</meaning>
</definition>""";
    content_hash "sha256:b05bb14d9ce704668584b0efade185aa83ae986c57bb826e7b08b1155930690b";
}

// m58282 «Position, Displacement, and Average Velocity» — fs-id1168326897289
fragment UP_M58282_DISTANCE_TRAVELED in M58282_MAIN {
    kind defn;
    locator "module/m58282#fs-id1168326897289";
    text en official """<definition id="fs-id1168326897289">
<term>distance traveled</term>
<meaning id="fs-id1168326925585">the total length of the path traveled between two positions</meaning>
</definition>""";
    content_hash "sha256:71c9f99b355ff52cbe0239077e7c18e138449b304761e933db5dfcba5c271e75";
}

// m58282 «Position, Displacement, and Average Velocity» — fs-id1168326925589
fragment UP_M58282_ELAPSED_TIME in M58282_MAIN {
    kind defn;
    locator "module/m58282#fs-id1168326925589";
    text en official """<definition id="fs-id1168326925589">
<term>elapsed time</term>
<meaning id="fs-id1168326801364">the difference between the ending time and the beginning time</meaning>
</definition>""";
    content_hash "sha256:8ad8739d9cb44fb6d39604fddebbc727ddfa16f13fd73d51e20303a9658bed86";
}

// m58282 «Position, Displacement, and Average Velocity» — fs-id1168326791706
fragment UP_M58282_AVERAGE_VELOCITY in M58282_MAIN {
    kind defn;
    locator "module/m58282#fs-id1168326791706";
    text en official """<definition id="fs-id1168326791706">
<term>average velocity</term>
<meaning id="fs-id1168329400870">the displacement divided by the time over which displacement occurs under constant acceleration</meaning>
</definition>""";
    content_hash "sha256:bcc82506309bf116722c917a7a5c7d396e5f5804a623c7ad78a4b530fed76687";
}

// m58283 «Instantaneous Velocity and Speed» — fs-id1168329478735
fragment UP_M58283_AVERAGE_SPEED in M58283_MAIN {
    kind defn;
    locator "module/m58283#fs-id1168329478735";
    text en official """<definition id="fs-id1168329478735">
<term>average speed</term>
<meaning id="fs-id1168326838470">the total distance traveled divided by elapsed time</meaning>
</definition>""";
    content_hash "sha256:c333a9af34229a95dd0c11994a2bba9abf91e1833578e9a7f5265a8608a85e60";
}

// m58284 «Average and Instantaneous Acceleration» — fs-id1168328300463
fragment UP_M58284_AVERAGE_ACCELERATION in M58284_MAIN {
    kind defn;
    locator "module/m58284#fs-id1168328300463";
    text en official """<definition id="fs-id1168328300463">
<term>average acceleration</term>
<meaning id="fs-id1168328180604">the rate of change in velocity; the change in velocity over time</meaning>
</definition>""";
    content_hash "sha256:05e19a873c16515f124ae09745c19badfe52a6cd9b0f40bb3af3105de12ccecc";
}

// m58285 «Motion with Constant Acceleration» — fs-id1168326976101
fragment UP_M58285_KINEMATIC_EQUATIONS in M58285_MAIN {
    kind section;
    locator "module/m58285#fs-id1168326976101";
    text en official """<note id="fs-id1168326976101">
<title>Summary of Kinematic Equations (constant <emphasis effect="italics">a</emphasis>)</title>
<equation id="fs-id1168329502284" class="unnumbered"><label/><m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:msub><m:mi>x</m:mi><m:mn>0</m:mn></m:msub><m:mo>+</m:mo><m:mover><m:mi>v</m:mi><m:mtext>–</m:mtext></m:mover><m:mi>t</m:mi></m:mrow></m:math></equation>
<equation id="fs-id1168329198282" class="unnumbered"><label/><m:math><m:mrow><m:mover><m:mi>v</m:mi><m:mtext>–</m:mtext></m:mover><m:mo>=</m:mo><m:mfrac><m:mrow><m:msub><m:mi>v</m:mi><m:mn>0</m:mn></m:msub><m:mo>+</m:mo><m:mi>v</m:mi></m:mrow><m:mn>2</m:mn></m:mfrac></m:mrow></m:math></equation>
<equation id="fs-id1168329511512" class="unnumbered"><label/><m:math><m:mrow><m:mi>v</m:mi><m:mo>=</m:mo><m:msub><m:mi>v</m:mi><m:mn>0</m:mn></m:msub><m:mo>+</m:mo><m:mi>a</m:mi><m:mi>t</m:mi></m:mrow></m:math></equation>
<equation id="fs-id1168326938891" class="unnumbered"><label/><m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:msub><m:mi>x</m:mi><m:mn>0</m:mn></m:msub><m:mo>+</m:mo><m:msub><m:mi>v</m:mi><m:mn>0</m:mn></m:msub><m:mi>t</m:mi><m:mo>+</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:mi>a</m:mi><m:msup><m:mi>t</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math></equation>
<equation id="fs-id1168326907357" class="unnumbered"><label/><m:math><m:mrow><m:msup><m:mi>v</m:mi><m:mn>2</m:mn></m:msup><m:mo>=</m:mo><m:msubsup><m:mi>v</m:mi><m:mn>0</m:mn><m:mn>2</m:mn></m:msubsup><m:mo>+</m:mo><m:mn>2</m:mn><m:mi>a</m:mi><m:mrow><m:mo>(</m:mo><m:mrow><m:mi>x</m:mi><m:mo>−</m:mo><m:msub><m:mi>x</m:mi><m:mn>0</m:mn></m:msub></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow></m:math></equation>
</note>""";
    content_hash "sha256:591e50880b27bcb1a07abe49b95e09becb90009c0bba2892f338e1dc4ee93cf0";
}

// m58286 «Free Fall» — fs-id1168328329319
fragment UP_M58286_FREE_FALL in M58286_MAIN {
    kind defn;
    locator "module/m58286#fs-id1168328329319";
    text en official """<definition id="fs-id1168328329319">
<term>free fall</term>
<meaning id="fs-id1168328319810">the state of movement that results from gravitational force only</meaning>
</definition>""";
    content_hash "sha256:98b58711b88c65c3c877a37b53e6f9a565ba54a3b3b607d6c9ffadaf83a684ec";
}

// m58286 «Free Fall» — fs-id1168325737439
fragment UP_M58286_G_VALUE in M58286_MAIN {
    kind section;
    locator "module/m58286#fs-id1168325737439";
    text en official """<equation id="fs-id1168325737439" class="unnumbered"><label/><m:math><m:mrow><m:mi>g</m:mi><m:mo>=</m:mo><m:mn>9.81</m:mn><m:mspace width="0.2em"/><m:msup><m:mrow><m:mtext>m/s</m:mtext></m:mrow><m:mn>2</m:mn></m:msup><m:mspace width="0.5em"/><m:mo stretchy="false">(</m:mo><m:mtext>or</m:mtext><m:mspace width="0.2em"/><m:mn>32.2</m:mn><m:mspace width="0.2em"/><m:msup><m:mtext>ft/s</m:mtext><m:mn>2</m:mn></m:msup><m:mo stretchy="false">)</m:mo><m:mo>.</m:mo></m:mrow></m:math></equation>""";
    content_hash "sha256:2d28795dff045f9c8cd937ce683cae70e893366855946512b251d7b81ad1dfc9";
}

// m58292 «Uniform and Nonuniform Circular Motion» — fs-id1165168910019
fragment UP_M58292_CENTRIPETAL_ACCELERATION in M58292_MAIN {
    kind defn;
    locator "module/m58292#fs-id1165168910019";
    text en official """<definition id="fs-id1165168910019">
<term>centripetal acceleration</term>
<meaning id="fs-id1165168910025">component of acceleration of an object moving in a circle that is directed radially inward toward the center of the circle</meaning>
</definition>""";
    content_hash "sha256:b84e86865848ba798366decf5711be381a7ac1734820d3f84c1b7851ae2c07ea";
}

// m58292 «Uniform and Nonuniform Circular Motion» — fs-id1165168910030
fragment UP_M58292_TANGENTIAL_ACCELERATION in M58292_MAIN {
    kind defn;
    locator "module/m58292#fs-id1165168910030";
    text en official """<definition id="fs-id1165168910030">
<term>tangential acceleration</term>
<meaning id="fs-id1165168910036">magnitude of which is the time rate of change of speed. Its direction is tangent to the circle.</meaning>
</definition>""";
    content_hash "sha256:dd65bc56c7217b1eaa14d038db352940dd6c3780c46321396dada8a61ba77190";
}

// m58293 «Relative Motion in One and Two Dimensions» — fs-id1165039252507
fragment UP_M58293_REFERENCE_FRAME in M58293_MAIN {
    kind defn;
    locator "module/m58293#fs-id1165039252507";
    text en official """<definition id="fs-id1165039252507">
<term>reference frame</term>
<meaning id="fs-id1165039252512">coordinate system in which the position, velocity, and acceleration of an object at rest or moving is measured</meaning>
</definition>""";
    content_hash "sha256:4d724f4cad2636be2869c2e10aba7829b6d4681c4385c9b521227f2ebac6bc8d";
}

// m58293 «Relative Motion in One and Two Dimensions» — fs-id1165039111736
fragment UP_M58293_TWO_DIMENSIONAL_SPEED in M58293_MAIN {
    kind section;
    locator "module/m58293#fs-id1165039111736";
    text en official """<equation id="fs-id1165039111736" class="unnumbered"><label/><m:math><m:mrow><m:mrow><m:mo>|</m:mo><m:mrow><m:msub><m:mstyle mathvariant="bold" mathsize="normal"><m:mover accent="true"><m:mi>v</m:mi><m:mo stretchy="false">→</m:mo></m:mover></m:mstyle><m:mrow><m:mtext>CT</m:mtext></m:mrow></m:msub></m:mrow><m:mo>|</m:mo></m:mrow><m:mo>=</m:mo><m:msqrt><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>80.0</m:mn><m:mspace width="0.2em"/><m:mrow><m:mrow><m:mtext>km</m:mtext></m:mrow><m:mtext>/</m:mtext><m:mrow><m:msup><m:mrow><m:mtext>h</m:mtext><m:mo stretchy="false">)</m:mo></m:mrow><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mo stretchy="false">(</m:mo></m:mrow></m:mrow><m:mn>70.0</m:mn><m:mspace width="0.2em"/><m:mrow><m:mrow><m:mtext>km</m:mtext></m:mrow><m:mtext>/</m:mtext><m:mrow><m:msup><m:mrow><m:mtext>h</m:mtext><m:mo stretchy="false">)</m:mo></m:mrow><m:mn>2</m:mn></m:msup></m:mrow></m:mrow></m:mrow></m:msqrt><m:mo>=</m:mo><m:mn>106.</m:mn><m:mspace width="0.2em"/><m:mrow><m:mrow><m:mtext>km</m:mtext></m:mrow><m:mtext>/</m:mtext><m:mtext>h</m:mtext></m:mrow></m:mrow></m:math></equation>""";
    content_hash "sha256:86c02e2a91302cce11f703903f2c22477ceaf49945acc79019f0bba93ab66de9";
}

// m58293 «Relative Motion in One and Two Dimensions» — fs-id1165039252518
fragment UP_M58293_RELATIVE_VELOCITY in M58293_MAIN {
    kind defn;
    locator "module/m58293#fs-id1165039252518";
    text en official """<definition id="fs-id1165039252518">
<term>relative velocity</term>
<meaning id="fs-id1165039252523">velocity of an object as observed from a particular reference frame, or the velocity of one reference frame with respect to another reference frame</meaning>
</definition>""";
    content_hash "sha256:1f58247b5fedf91fbf5e212456a36fe9751153c77c20330829459c954bff7e46";
}
