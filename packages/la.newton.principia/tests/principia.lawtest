language "law.core" version "0.2";
package la.newton.principia version "0.1.0";
namespace "urn:la:newton:clir:principia";

// Сценарии перенесены из прежнего Python-раннера семейства `principia`.
// Заголовки — прежние ID сценариев (scenario-manifest); ожидания
// выведены из ПРЕЖНИХ проверок, а не из ответов движка.

test "PRIN-01-AER-DUPLO-DENSIOR-QUADRUPLUS" {
    given {
        context {
            decision_time @2026-08-26T12:00:00+05:00;
            knowledge_time @2026-08-26T12:00:00+05:00;
            legal_time @2026-08-31;
            timezone "Asia/Qyzylorda";
        }

        assert "assert-f0": densitas_corporis(entity_ref("urn:case:prin:corpus-a"), 2 pars_densitatis) {
            origin case_input;
        }

        assert "assert-f1": magnitudo_corporis(entity_ref("urn:case:prin:corpus-a"), 2 pars_spatii) {
            origin case_input;
        }
    }

    evaluate truth(quantitas_materiae(entity_ref("urn:case:prin:corpus-a"), 4 pars_materiae));
    expect truth_status == TRUE_ONLY;
    expect issues_within(info);

    evaluate truth(quantitas_materiae(entity_ref("urn:case:prin:corpus-a"), 5 pars_materiae));
    expect truth_status == NEITHER;
    expect issues_within(info);
}

