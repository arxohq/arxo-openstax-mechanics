// Общие типы пакета la.newton.principia — аксиоматический каркас «Principia»
// (первое издание, 1687): Definitiones + Axiomata, sive Leges Motus.
//
// КАРТА МОДУЛЕЙ (разрез зеркалит источник — он структурирован):
//   00-package.law            — типы, нужные ≥2 модулям (Corpus, StatusCorporis)
//   01-definitiones.law       — единицы 1–8: Def. I–VIII, эталоны «частей»
//   02-scholium-definitionum.law — единица 9: корабль, участие в движении, сосуд
//   03-leges.law              — единицы 10–12: Lex. I–III
//   04-corollaria.law         — единицы 13–18: Corol. I–VI
//   05-scholium-legum.law     — единица 19: опыты, упругость, машины, Галилей
//   analysis.law              — ненормативное: контрфактуал закона I
//   sources.law               — порождается sync_principia_fragments.py
//
// СИСТЕМА ЕДИНИЦ — «ЧАСТИ» (partes) САМОГО ТЕКСТА. Первоиздание не знает ни
// СИ, ни каких-либо фиксированных единиц: свои примеры оно считает в
// «частях» («motus ipsius A sit ad motum ipsius B ut sex ad decem; ponantur
// motus illis esse partium sex & decem»). Пакет закрепляет это буквально:
// Quantity с тегами pars_materiae, pars_velocitatis, pars_motus,
// pars_densitatis, pars_spatii, pars_distantiae. Деление на эталон (E-0068)
// проверяет единицу на входе, with_unit (E-0074) пришивает её на выходе;
// алгебры, связывающей теги между собой, у Core 0.1 нет — правильность
// каждой формулы утверждает @source-якорь на формулировку, где она стоит.
//
// МЕРА ДВИЖУЩЕЙ СИЛЫ — В ЧАСТЯХ ДВИЖЕНИЯ, ПО ОПРЕДЕЛЕНИЮ САМОГО ТЕКСТА:
// Def. VIII меряет vis motrix «motui, quem dato tempore generat» — движением,
// которое она порождает; Def. VII меряет vis acceleratrix порождаемой
// скоростью. Поэтому отдельных тегов силы нет НАМЕРЕННО: сила в этом
// исчислении и есть порождаемые ею partes motus / partes velocitatis.
//
// ГРАНИЦЫ ПАКЕТА (названы здесь, повторены при своих единицах):
//   - книги I–III «Principia» — непрерывная динамика (флюксии, предельные
//     переходы, орбиты) вне вычислимой поверхности Core 0.1 и вне
//     закреплённого среза;
//   - геометрия НАПРАВЛЕНИЙ вне коллинеарного случая — параллелограмм сил
//     (Corol. I), разложение по наклонным (Corol. II, кроме рычага),
//     косые соударения (хвост Corol. III) — векторной алгебры у языка нет;
//     коллинеарные случаи выражены отношениями «in eandem partem» /
//     «in partes contrarias», как считает их сам текст;
//   - сравнение движений МЕЖДУ системами отсчёта (Corol. V, VI) — требует
//     сопоставления двух исполнений одной системы правил, то есть вопроса к
//     двум делам сразу; выразим слоем сценариев, не правилом;
//   - извлечения корня нет (E-число закрыто границей у Евклида тем же
//     образом): скорость маятника «ut chorda arcus» берётся делом как факт.

language "law.core" version "0.2";
package la.newton.principia version "0.1.0";
namespace "urn:la:newton:clir:principia";

use self::{
    PRIN_10,
};

// ЧТО ЭКСПОРТИРУЕТСЯ. Оригинал Ньютона — одно из двух прочтений второго
// закона в `openstax.dynamics` (уровень мостов, DECISION-0127 §…): дело,
// выбравшее прочтение Principia, читает ОТСЮДА тело, его состояние и
// перемену движения. Экспортируются `Corpus`, `StatusCorporis` и четыре
// отношения — барьер закона I, перемена движения закона II и взаимность
// закона III. Правила не экспортируются: импорт несёт интерфейс, а не узлы
// (§23), и латинские нормы исполняются в СВОЁМ пакете.
//
// Тело — носитель всех величин пакета. «Corpus omne…» (Lex. I).
pub entity Corpus {
    label la official "corpus";
    label ru unofficial "тело — носитель количества материи, движения и сил";
}

// Состояние тела по Lex. I: покой либо равномерное прямолинейное движение.
// Перечень закрыт самим текстом закона («in statu suo vel quiescendi vel
// movendi uniformiter in directum») — третьего состояния закон не называет.
@source(PRIN_10)
pub enum StatusCorporis {
    label ru unofficial "состояние тела по закону I: покой либо равномерное прямолинейное движение";
    Quiescendi,
    MovendiUniformiter
}
