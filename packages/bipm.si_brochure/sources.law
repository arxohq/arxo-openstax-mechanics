// Source-модель: закреплённые байты брошюры SI (BIPM) — 9-е издание на
// английском и французском и английская часть 8-го издания — и фрагменты
// английских текстов обеих редакций.
//
// ФАЙЛ ПОРОЖДАЕТСЯ. Правится только генератором —
// `corpus/tools/sources/sync/sync_bipm_si_brochure_fragments.py`; сверка без
// записи — его же ключом `--check`. Тексты вырезаются из
// `sources/si-brochure/{en9,en8}.txt`, поэтому разойтись с публикацией они
// не могут.
//
// ПРОВЕНАНС. Байты получены воспроизводимым извлечением из PDF со страницы
// публикаций BIPM штатным `pdftotext -layout` при poppler 25.06.0; входные
// PDF пинуются хэшем: 9-е изд. EN sha256:5442eea2c680caf77a9d96879205a97f57c7c270b98a0bd0126c18fefe47e02c,
// 9-е изд. FR sha256:e8395750d374c5aca5ea170c51243fa69b1ddd01cac54bdbdba51f9a61d49cba,
// 8-е изд. (двуязычный) sha256:68eb39b47ee611f7b1810a0b45fae39680dcf12a2233ec7365b8bafdbceacd68.
// Лицензия — Creative Commons Attribution 4.0 (страница BIPM и с. 2 PDF).
// `materialization_status` — PINNED_UNOFFICIAL_COPY: закреплено извлечение из
// PDF, а не байты самого PDF. `retrieved_at` — константа (DECISION-0005 п. 6).
//
// ДВЕ РЕДАКЦИИ ОДНОГО ДОКУМЕНТА, И ОНИ РАСХОДЯТСЯ ПО СУЩЕСТВУ: 8-е издание
// определяет килограмм через международный прототип, ампер через силу между
// проводниками, кельвин через тройную точку воды, моль через 0,012 кг
// углерода-12; 9-е издание — все семь единиц через семь определяющих
// констант, в силе с 20 мая 2019 (резолюция 1 26-й ГКМВ, 2018; приложение 1).
// Секунда, метр и кандела определены через те же константы в обеих
// редакциях, разница только в формулировке.
//
// ФРАНЦУЗСКИЙ ТЕКСТ — ПОДЛИННИК (так говорит сама брошюра). Он закреплён
// редакцией `SI_BROCHURE_9_FR` без фрагментов: формализация ведётся по
// английскому тексту, разметка французского — названный долг. Английская
// редакция объявлена `officiality official`: BIPM публикует её сам.

language "law.core" version "0.2";
package bipm.si_brochure version "0.1.0";
namespace "urn:bipm:clir:si-brochure";

source SI_BROCHURE {
    // `standard` — справочный документ межправительственной организации
    // (Метрическая конвенция), собирающий резолюции ГКМВ; юрисдикция
    // `International`, как у резолюций МАС и кодекса ICZN.
    kind standard;
    jurisdiction International;
    number "BIPM, The International System of Units (SI), 8th edition (2006) and 9th edition (2019, v4.01)";
    label en official "The International System of Units (SI)";
    label fr official "Le Système international d’unités (SI)";
    label ru unofficial "Международная система единиц (SI), брошюра BIPM";
}

edition SI_BROCHURE_8_EN of SI_BROCHURE {
    label en official "The International System of Units (SI), 8th edition, 2006 — English text of the bilingual edition";
    label ru unofficial "8-е издание (2006), английская часть двуязычного издания";
    language en;
    officiality official;
    adopted @2006-01-01;
    in_force [@2006-01-01, @2019-05-20);
    materialization_status PINNED_UNOFFICIAL_COPY;
}

publication SI_BROCHURE_8_EN_TEXT of SI_BROCHURE_8_EN {
    media_type "text/plain; charset=utf-8";
    uri "https://www.bipm.org/documents/20126/41483022/si_brochure_8.pdf";
    retrieved_at @2026-09-06T00:00:00Z;
    content_hash "sha256:75189f3babd57d9246af75c773507d027a0df049e5fb9eceb71fb9bb958f60e1";
    local_path "sources/si-brochure/en8.txt";
}

edition SI_BROCHURE_9_EN of SI_BROCHURE {
    label en official "The International System of Units (SI), 9th edition, 2019, version 4.01";
    label ru unofficial "9-е издание (2019), версия 4.01, английский текст";
    language en;
    officiality official;
    adopted @2018-11-16;
    in_force [@2019-05-20, infinity);
    materialization_status PINNED_UNOFFICIAL_COPY;
}

publication SI_BROCHURE_9_EN_TEXT of SI_BROCHURE_9_EN {
    media_type "text/plain; charset=utf-8";
    uri "https://www.bipm.org/documents/20126/41483022/SI-Brochure-9-EN.pdf";
    retrieved_at @2026-09-06T00:00:00Z;
    content_hash "sha256:e4de27dc33f988f97fc94da61a28830deb61d82944ff9023c1b8e8e119f2b980";
    local_path "sources/si-brochure/en9.txt";
}

edition SI_BROCHURE_9_FR of SI_BROCHURE {
    label fr official "Le Système international d’unités (SI), 9e édition, 2019, version 4.01";
    label ru unofficial "9-е издание (2019), версия 4.01, французский подлинник; фрагменты не размечены";
    language fr;
    officiality official;
    adopted @2018-11-16;
    in_force [@2019-05-20, infinity);
    materialization_status PINNED_UNOFFICIAL_COPY;
}

publication SI_BROCHURE_9_FR_TEXT of SI_BROCHURE_9_FR {
    media_type "text/plain; charset=utf-8";
    uri "https://www.bipm.org/documents/20126/41483022/SI-Brochure-9-FR.pdf";
    retrieved_at @2026-09-06T00:00:00Z;
    content_hash "sha256:bceec64d96fc9c791aea38592c93bfa852600adecddfcac295c155d3646456b9";
    local_path "sources/si-brochure/fr9.txt";
}

// --- 9-е издание, английский текст ---------------------------------------

// §2.2: SI — система единиц, в которой семь констант имеют фиксированные значения
fragment SI9_S2_2_DEFINITION_OF_SI in SI_BROCHURE_9_EN {
    kind provision;
    locator "section/2.2/definition";
    text en official """The International System of Units, the SI, is the system of units in which
• the unperturbed ground state hyperfine transition frequency of the caesium
133 atom, ∆νCs, is 9 192 631 770 Hz,
• the speed of light in vacuum, c, is 299 792 458 m/s,
• the Planck constant, h, is 6.626 070 15 × 10−34 J s,
• the elementary charge, e, is 1.602 176 634 × 10−19 C,
• the Boltzmann constant, k, is 1.380 649 × 10−23 J/K,
• the Avogadro constant, NA, is 6.022 140 76 × 1023 mol−1,
• the luminous efficacy of monochromatic radiation of frequency
540 × 1012 Hz, Kcd, is 683 lm/W,""";
    content_hash "sha256:186bea9a7e8e45241bf08305fc7f7d05fee96c1d1df4b8b841043bb2a9deeb52";
}

// §2.2: связь Hz, J, C, lm, W с базовыми единицами; значения констант без неопределённости
pub fragment SI9_S2_2_UNIT_RELATIONS in SI_BROCHURE_9_EN {
    kind provision;
    locator "section/2.2/relations";
    text en official """where the hertz, joule, coulomb, lumen, and watt, with unit symbols Hz, J, C, lm, and W,
respectively, are related to the units second, metre, kilogram, ampere, kelvin, mole, and
candela, with unit symbols s, m, kg, A, K, mol, and cd, respectively, according to Hz = s–1,
J = kg m2 s– 2, C = A s, lm = cd sr, and W = kg m2 s–3.
The numerical values of the seven defining constants have no uncertainty.""";
    content_hash "sha256:a2129c13bcd907dfdd657785e5d386188697524d86979439e0d86f0898e496a4";
}

// Таблица 1: семь определяющих констант и единицы, которые они определяют
pub fragment SI9_TABLE_1 in SI_BROCHURE_9_EN {
    kind table;
    locator "section/2.2/table-1";
    text en official """Table 1. The seven defining constants of the SI and the seven corresponding units
they define
___________________________________________________________________________
Defining constant Symbol Numerical value Unit
___________________________________________________________________________
hyperfine transition
frequency of Cs ∆νCs 9 192 631 770 Hz
speed of light in vacuum c 299 792 458 m s−1
Planck constant h 6.626 070 15 × 10−34 Js
elementary charge e 1.602 176 634 × 10−19 C
Boltzmann constant k 1.380 649 × 10 −23
J K−1
Avogadro constant NA 6.022 140 76 × 1023 mol−1
luminous efficacy Kcd 683 lm W−1""";
    content_hash "sha256:7af45fae4cb7a313e6c6425db7389d026287af5edadb25837e7fd871ec1e9fbb";
}

// Таблица 2: базовые величины и базовые единицы
fragment SI9_TABLE_2 in SI_BROCHURE_9_EN {
    kind table;
    locator "section/2.3.1/table-2";
    text en official """Table 2. SI base units
_____________________________________________________________________________
Base quantity Base unit
_____________________________________________________________________________
Name Typical symbol Name Symbol
_____________________________________________________________________________
time t second s
length l, x, r, etc. metre m
mass m kilogram kg
electric current I, i ampere A
thermodynamic temperature T kelvin K
amount of substance n mole mol
luminous intensity Iv candela cd""";
    content_hash "sha256:bdd9a6b3aadcc3e36539d3972cbe501a92940a3328bf1920d89660a3acc9e77b";
}

// §2.3.1: определение секунды через ∆νCs
fragment SI9_DEF_SECOND in SI_BROCHURE_9_EN {
    kind provision;
    locator "section/2.3.1/second";
    text en official """The second, symbol s, is the SI unit of time. It is defined by taking the fixed numerical
value of the caesium frequency, ∆νCs, the unperturbed ground-state hyperfine
transition frequency of the caesium 133 atom, to be 9 192 631 770 when expressed in the
unit Hz, which is equal to s−1.""";
    content_hash "sha256:a2b330de77b8fb6a298ffbbc5e22952db51f936a67c6a911f6df4afc0a5df01b";
}

// §2.3.1: определение метра через c
fragment SI9_DEF_METRE in SI_BROCHURE_9_EN {
    kind provision;
    locator "section/2.3.1/metre";
    text en official """The metre, symbol m, is the SI unit of length. It is defined by taking the fixed numerical
value of the speed of light in vacuum, c, to be 299 792 458 when expressed in the unit m
s−1, where the second is defined in terms of the caesium frequency ∆νCs.""";
    content_hash "sha256:9776d44ec57958c405378e1585c171bf44eebe01426be027f959a77064d4c8e0";
}

// §2.3.1: определение килограмма через h
fragment SI9_DEF_KILOGRAM in SI_BROCHURE_9_EN {
    kind provision;
    locator "section/2.3.1/kilogram";
    text en official """The kilogram, symbol kg, is the SI unit of mass. It is defined by taking the fixed
numerical value of the Planck constant, h, to be 6.626 070 15 × 10−34 when expressed in
the unit J s, which is equal to kg m2 s−1, where the metre and the second are defined in
terms of c and ∆νCs.""";
    content_hash "sha256:96dae548d302b9211c1c70f6e206bf377de3b0c9fbb7327d36e875da4063d572";
}

// §2.3.1: определение ампера через e
fragment SI9_DEF_AMPERE in SI_BROCHURE_9_EN {
    kind provision;
    locator "section/2.3.1/ampere";
    text en official """The ampere, symbol A, is the SI unit of electric current. It is defined by taking the fixed
numerical value of the elementary charge, e, to be 1.602 176 634 × 10−19 when expressed
in the unit C, which is equal to A s, where the second is defined in terms of ∆νCs.""";
    content_hash "sha256:ee5d176bd7c10a5fd04b88fca6c4230500668da6aac99d1d3c36a4cefebe9e2e";
}

// §2.3.1: определение кельвина через k
fragment SI9_DEF_KELVIN in SI_BROCHURE_9_EN {
    kind provision;
    locator "section/2.3.1/kelvin";
    text en official """The kelvin, symbol K, is the SI unit of thermodynamic temperature. It is defined by
taking the fixed numerical value of the Boltzmann constant, k, to be 1.380 649 × 10−23
when expressed in the unit J K−1, which is equal to kg m2 s−2 K−1, where the kilogram,
metre and second are defined in terms of h, c and ∆νCs.""";
    content_hash "sha256:e7d9ee6b2f490124223d1accc13282a3b5738bb04df8ca36916189010fd2388d";
}

// §2.3.1: определение моля через NA
fragment SI9_DEF_MOLE in SI_BROCHURE_9_EN {
    kind provision;
    locator "section/2.3.1/mole";
    text en official """The mole, symbol mol, is the SI unit of amount of substance. One mole contains exactly
6.022 140 76 × 1023 elementary entities. This number is the fixed numerical value of the
Avogadro constant, NA, when expressed in the unit mol−1 and is called the Avogadro
number.""";
    content_hash "sha256:a11e8e01b96d54037f81044afa61838d441ef84f48bcdf4855c3a7ebf94bac16";
}

// §2.3.1: определение канделы через Kcd
fragment SI9_DEF_CANDELA in SI_BROCHURE_9_EN {
    kind provision;
    locator "section/2.3.1/candela";
    text en official """The candela, symbol cd, is the SI unit of luminous intensity in a given direction. It is
defined by taking the fixed numerical value of the luminous efficacy of monochromatic
radiation of frequency 540 × 1012 Hz, Kcd, to be 683 when expressed in the unit lm W−1,
which is equal to cd sr W−1, or cd sr kg−1 m−2 s3, where the kilogram, metre and second
are defined in terms of h, c and ∆νCs.""";
    content_hash "sha256:e0ef37a23e1dd6bb5def7debca8079b9612fe024405e5bef9b40d84e7ecb37ec";
}

// §2.3.1: градус Цельсия равен кельвину по величине; t/°C = T/K − 273.15
fragment SI9_S2_3_1_CELSIUS in SI_BROCHURE_9_EN {
    kind provision;
    locator "section/2.3.1/celsius";
    text en official """The unit of Celsius temperature is the degree Celsius, symbol °C, which is by definition equal
in magnitude to the unit kelvin. A difference or interval of temperature may be expressed in
kelvins or in degrees Celsius, the numerical value of the temperature difference being the
same in either case. However, the numerical value of a Celsius temperature expressed in
degrees Celsius is related to the numerical value of the thermodynamic temperature expressed
in kelvins by the relation
t/°C = T/K − 273.15""";
    content_hash "sha256:81773254636a642ed6da3aec77e32cafb409eae407b17017686a27135b328f9a";
}

// §2.3.4: производные и когерентные производные единицы
fragment SI9_S2_3_4_COHERENT in SI_BROCHURE_9_EN {
    kind provision;
    locator "section/2.3.4/coherent";
    text en official """Derived units are defined as products of powers of the base units. When the numerical factor
of this product is one, the derived units are called coherent derived units. The base and
coherent derived units of the SI form a coherent set, designated the set of coherent SI units.
The word “coherent” here means that equations between the numerical values of quantities
take exactly the same form as the equations between the quantities themselves.""";
    content_hash "sha256:b9e6a117312c189b30c283ce54aee8fdfdea00c8fe550f1c0236e766dc9186cb";
}

// §2.3.4: 22 единицы со специальными названиями; вместе с базовыми — 29
fragment SI9_S2_3_4_SPECIAL_NAMES in SI_BROCHURE_9_EN {
    kind provision;
    locator "section/2.3.4/special-names";
    text en official """Some of the coherent derived units in the SI are given special names. Table 4 lists 22 SI units
with special names. Together with the seven base units (Table 2) they form the core of the
set of SI units. All other SI units are combinations of some of these 29 units.""";
    content_hash "sha256:515a61fe3b5e76008a87be79f0c0d988a935aee92c2d22abefed37564313eba0";
}

// §2.3.4: префиксы применимы к 29 единицам со специальными названиями, кроме килограмма
fragment SI9_S2_3_4_PREFIX_EXCEPTION in SI_BROCHURE_9_EN {
    kind provision;
    locator "section/2.3.4/prefix-exception";
    text en official """The CGPM has adopted a series of prefixes for use in forming the decimal multiples and sub-
multiples of the coherent SI units (see chapter 3). They are convenient for expressing the
values of quantities that are much larger than or much smaller than the coherent unit.
However, when prefixes are used with SI units, the resulting units are no longer coherent,
because the prefix introduces a numerical factor other than one. Prefixes may be used with
any of the 29 SI units with special names with the exception of the base unit kilogram, which
is further explained in chapter 3.""";
    content_hash "sha256:c093af4db37dce32abaf0950fef702d7f2a024f35700fa39bfc5a3875e4db083";
}

// Таблица 4: 22 единицы со специальными названиями, выражение через базовые
fragment SI9_TABLE_4 in SI_BROCHURE_9_EN {
    kind table;
    locator "section/2.3.4/table-4";
    text en official """Table 4. The 22 SI units with special names and symbols
_____________________________________________________________________________________________
Special name Unit expressed in Unit expressed in
Derived quantity of unit Symbol terms of base units (a) terms of other SI units
______________________________________________________________________________________________
plane angle radian (b) rad (b) 1
solid angle steradian (c) sr (c) 1
frequency hertz (d) Hz s−1
force newton N kg m s−2
pressure, stress pascal Pa kg m−1 s−2 N/m2
energy, work, joule J kg m2 s−2 Nm
amount of heat
power, radiant flux watt W kg m2 s−3 J/s
electric charge coulomb C As
electric potential difference (e) volt V kg m2 s−3 A−1 W/A
capacitance farad F kg−1 m−2 s4 A2 C/V
electric resistance ohm Ω kg m2 s−3 A−2 V/A
electric conductance siemens S kg −1 m−2 s3 A2 A/V
magnetic flux weber Wb kg m2 s−2 A−1 Vs
magnetic flux density tesla T kg s−2 A−1 Wb/m2
inductance henry H kg m 2 s−2 A−2 Wb/A
134 • The International System of Units
Celsius temperature degree Celsius (f) °C K
luminous flux lumen lm cd sr (g) cd sr
illuminance lux lx cd sr m−2 lm/m2
activity referred to becquerel Bq s−1
a radionuclide (d, h)
absorbed dose, kerma gray Gy m2 s−2 J/kg
dose equivalent sievert (i) Sv m2 s−2 J/kg
catalytic activity katal kat mol s −1""";
    content_hash "sha256:fd0d2e3ba1b4f130bcf6fbeb2bc54f86b671e4e4cab5a195f3a165f8c72d8070";
}

// §2.3.4: полный набор единиц SI — когерентные плюс кратные и дольные
fragment SI9_S2_3_4_COMPLETE_SET in SI_BROCHURE_9_EN {
    kind provision;
    locator "section/2.3.4/complete-set";
    text en official """The seven base units and 22 units with special names and symbols may be used in
combination to express the units of other derived quantities. Since the number of quantities
is without limit, it is not possible to provide a complete list of derived quantities and derived
units. Table 5 lists some examples of derived quantities and the corresponding coherent
derived units expressed in terms of base units. In addition, Table 6 lists examples of coherent
derived units whose names and symbols also include derived units. The complete set of SI
units includes both the coherent set and the multiples and sub-multiples formed by using the
SI prefixes.""";
    content_hash "sha256:ba07f1b3c6f8c3772a950b6e0b74315712b3c468206b9b83cc70ec6b0ee93720";
}

// §3: кратные и дольные от 10^30 до 10^−30
fragment SI9_S3_INTRO in SI_BROCHURE_9_EN {
    kind provision;
    locator "section/3/intro";
    text en official """Decimal multiples and submultiples ranging from 1030 to 10−30 are provided for use with the
SI units. The names and symbols of these multiple and sub-multiple prefixes are presented
in Table 7.""";
    content_hash "sha256:287904741f4b52ca7afad9cf582c6821a418beb6ad4c42871ec10793d20aecd9";
}

// Таблица 7: префиксы SI
fragment SI9_TABLE_7 in SI_BROCHURE_9_EN {
    kind table;
    locator "section/3/table-7";
    text en official """Table 7. SI prefixes
_____________________________________________________________________________
Factor Name Symbol Factor Name Symbol
101 deca da 10−1 deci d
10 2
hecto h 10−2 centi c
10 3
kilo k 10 −3
milli m
106 mega M 10−6 micro µ
109 giga G 10−9 nano n
10 12
tera T 10 −12
pico p
1015 peta P 10−15 femto f
1018 exa E 10−18 atto a
1021 zetta Z 10−21 zepto z
10 24
yotta Y 10 −24
yocto y
10 27
ronna R 10 −27
ronto r
1030 quetta Q 10−30 quecto q""";
    content_hash "sha256:12e43dffddcc8f179c629bcd2a1de930f970f632899c8a4da3f5ff3643c05559";
}

// §3: префикс с единицей — новый неразделимый символ
fragment SI9_S3_INSEPARABLE in SI_BROCHURE_9_EN {
    kind provision;
    locator "section/3/inseparable";
    text en official """The grouping formed by a prefix symbol attached to a unit symbol constitutes a new
inseparable unit symbol (forming a multiple or sub-multiple of the unit concerned) that can
be raised to a positive or negative power and that can be combined with other unit symbols
to form compound unit symbols.""";
    content_hash "sha256:f100b1f76283e004d1b8c8b32f818afc84c62ffb98e7a0416a2057b8fbaec48b";
}

// §3: составные префиксы не допускаются
fragment SI9_S3_COMPOUND in SI_BROCHURE_9_EN {
    kind provision;
    locator "section/3/compound";
    text en official """Compound prefix symbols, i.e. prefix symbols formed by the juxtaposition of two or more
prefix symbols, are not permitted. This rule also applies to two or more compound prefix
names.""";
    content_hash "sha256:7271a37ae1b8b3f1bdc28994ba3fc71acb0ddbeb089df35c4c5052706b44e846";
}

// §3: килограмм — единственная когерентная единица с префиксом; кратные образуются от грамма
fragment SI9_S3_KILOGRAM in SI_BROCHURE_9_EN {
    kind provision;
    locator "section/3/kilogram";
    text en official """For historical reasons, the kilogram is the only coherent SI unit that includes a prefix in its
name and symbol. Names and symbols for decimal multiples and sub-multiples of the unit of
mass are formed by attaching prefix names and symbols to the unit name “gram” and the unit
symbol “g” respectively. For example, 10−6 kg is written as milligram, mg, not as
microkilogram, µkg.""";
    content_hash "sha256:c745c0e5afd6eb4cc7d18f307b66172592a9256bc528d5e54d8997168a615dca";
}

// §4: внесистемные единицы, допускаемые к применению
fragment SI9_S4_INTRO in SI_BROCHURE_9_EN {
    kind provision;
    locator "section/4/intro";
    text en official """It is recognized that some non-SI units are widely used and that this is expected to continue
for many years. It is therefore important to recall the values of these non-SI units in terms of
SI units, because the SI is the internationally agreed reference with respect to which all other
units are defined. A non-exhaustive list of non-SI units is given in Table 8, grouped into
indicative unit categories to aid explanation.""";
    content_hash "sha256:29b0a429548094c549dbe93554a0d57bb24f970ccc798244745252608e18d734";
}

// Таблица 8: внесистемные единицы и их значения в SI
