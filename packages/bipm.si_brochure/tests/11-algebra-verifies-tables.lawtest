// Таблица 4 против реестра одним правилом (E-0139): все семь показателей строки Newton совпали.
test "urn:query:si-t11-table4-newton" {
    given {
        context { decision_time @2024-01-01T12:00:00Z; knowledge_time @2024-01-01T12:00:00Z; legal_time @2024-01-01; timezone "UTC"; }
    }
    evaluate truth(base_expression_verified(Newton));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    expect applied(TableRowVerifiedByRegistry);
}

