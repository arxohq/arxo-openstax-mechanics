// 19.05.2019: постоянная Авогадро ещё не определяет моль.
test "urn:query:si-t03g-mole-avogadro-before" {
    given {
        context { decision_time @2019-05-19T12:00:00Z; knowledge_time @2019-05-19T12:00:00Z; legal_time @2019-05-19; timezone "UTC"; }
    }
    evaluate truth(defined_by_constant(Mole, AvogadroConstant));
    expect truth_status == NEITHER;
}
