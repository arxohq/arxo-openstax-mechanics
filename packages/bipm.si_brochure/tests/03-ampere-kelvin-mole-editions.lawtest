language "law.core" version "0.2";
package bipm.si_brochure version "0.1.0";
namespace "urn:bipm:clir:si-brochure";

// 19.05.2019: ампер через силу между проводниками.
test "urn:query:si-t03a-ampere-force-before" {
    given {
        context { decision_time @2019-05-19T12:00:00Z; knowledge_time @2019-05-19T12:00:00Z; legal_time @2019-05-19; timezone "UTC"; }
    }
    evaluate truth(defined_by_reference(Ampere, ForceBetweenParallelConductors));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    expect applied(AmpereByForceBetweenConductors);
}

// 20.05.2019: ампер через элементарный заряд.
test "urn:query:si-t03b-ampere-charge-after" {
    given {
        context { decision_time @2019-05-20T12:00:00Z; knowledge_time @2019-05-20T12:00:00Z; legal_time @2019-05-20; timezone "UTC"; }
    }
    evaluate truth(defined_by_constant(Ampere, ElementaryCharge));
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    expect applied(AmpereByElementaryCharge);
}

