language "law.core" version "0.2";
package bipm.si_brochure version "0.1.0";
namespace "urn:bipm:clir:si-brochure";

// §3: составной префикс (милли-микро) не допускается — FALSE_ONLY.
test "urn:query:si-t07a-compound-forbidden" {
    given {
        context { decision_time @2024-01-01T12:00:00Z; knowledge_time @2024-01-01T12:00:00Z; legal_time @2024-01-01; timezone "UTC"; }
    }
    evaluate truth(compound_prefix_permitted(Milli, Micro));
    expect truth_status == FALSE_ONLY;
    expect evaluation_status == COMPUTED;
    expect applied(NoCompoundPrefix);
}
