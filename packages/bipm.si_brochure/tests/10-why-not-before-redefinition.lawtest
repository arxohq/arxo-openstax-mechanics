language "law.core" version "0.2";
package bipm.si_brochure version "0.1.0";
namespace "urn:bipm:clir:si-brochure";

// 19.05.2019: почему килограмм ещё не определён через h — правило есть, но не в силе.
test "urn:query:si-t10-why-not-planck-before" {
    given {
        context { decision_time @2019-05-19T12:00:00Z; knowledge_time @2019-05-19T12:00:00Z; legal_time @2019-05-19; timezone "UTC"; }
    }
    evaluate why_not(defined_by_constant(Kilogram, PlanckConstant));
    expect truth_status == NEITHER;
    expect blocked_by("KilogramByPlanckConstant");
    expect blockers(1);
}
