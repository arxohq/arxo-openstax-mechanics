// §2.3.4 и таблица 4: 22 когерентные производные единицы со специальными
// названиями, их выражение через базовые единицы; когерентность и полный
// набор единиц SI.
//
// Показатели базовых единиц — целые факты из столбца «Unit expressed in
// terms of base units», ПОЛНЫМ вектором по семи базовым (нули включены):
// только так одно правило модуля 06 сверяет строку целиком, а не только
// ненулевые члены. Радиан и стерадиан — размерность один (сноски b, c), их
// векторы нулевые; люмен записан как cd (стерадиан — единица один, сноска g).
// Беккерель в реестре не объявлен отдельно: он s⁻¹, как герц (сноска d
// различает их по применению, не по размерности), поэтому его имя в реестре
// — Hz.

language "law.core" version "0.2";
package bipm.si_brochure version "0.1.0";
namespace "urn:bipm:clir:si-brochure";

use self::{
    BaseQuantity,
    SI8_TABLE_3,
    SI9_S2_3_4_COHERENT,
    SI9_S2_3_4_COMPLETE_SET,
    SI9_S2_3_4_SPECIAL_NAMES,
    SI9_TABLE_2,
    SI9_TABLE_4,
    SiUnit,
    base_unit,
};

@source(SI9_TABLE_4, SI8_TABLE_3)
pub relation special_unit(u: SiUnit, quantity: Text, symbol: Text) kind empirical {
    label en official "the unit is one of the 22 coherent derived units with a special name, for the given derived quantity, with the given symbol (Table 4)";
    label ru unofficial "единица — одна из 22 когерентных производных единиц со специальным названием, для данной производной величины, с данным символом (таблица 4)";
}

@source(SI9_TABLE_4, SI8_TABLE_3)
pub relation base_exponent(u: SiUnit, b: SiUnit, e: Integer) kind empirical {
    label en official "in the expression of the unit in terms of base units, the base unit appears with the given exponent (Table 4)";
    label ru unofficial "в выражении единицы через базовые данная базовая единица входит с данным показателем (таблица 4)";
}

@source(SI9_TABLE_4, SI8_TABLE_3)
facts Table4 {
    label en official "Table 4: the 22 SI units with special names and symbols";
    label ru unofficial "Таблица 4: 22 единицы SI со специальными названиями и символами";
    assert "t4-rad": special_unit(Radian, "plane angle", "rad") { }
    assert "t4-sr": special_unit(Steradian, "solid angle", "sr") { }
    assert "t4-hz": special_unit(Hertz, "frequency", "Hz") { }
    assert "t4-n": special_unit(Newton, "force", "N") { }
    assert "t4-pa": special_unit(Pascal, "pressure, stress", "Pa") { }
    assert "t4-j": special_unit(Joule, "energy, work, amount of heat", "J") { }
    assert "t4-w": special_unit(Watt, "power, radiant flux", "W") { }
    assert "t4-c": special_unit(Coulomb, "electric charge", "C") { }
    assert "t4-v": special_unit(Volt, "electric potential difference", "V") { }
    assert "t4-f": special_unit(Farad, "capacitance", "F") { }
    assert "t4-ohm": special_unit(Ohm, "electric resistance", "Ω") { }
    assert "t4-s": special_unit(Siemens, "electric conductance", "S") { }
    assert "t4-wb": special_unit(Weber, "magnetic flux", "Wb") { }
    assert "t4-t": special_unit(Tesla, "magnetic flux density", "T") { }
    assert "t4-h": special_unit(Henry, "inductance", "H") { }
    assert "t4-degc": special_unit(DegreeCelsius, "Celsius temperature", "°C") { }
    assert "t4-lm": special_unit(Lumen, "luminous flux", "lm") { }
    assert "t4-lx": special_unit(Lux, "illuminance", "lx") { }
    assert "t4-bq": special_unit(Becquerel, "activity referred to a radionuclide", "Bq") { }
    assert "t4-gy": special_unit(Gray, "absorbed dose, kerma", "Gy") { }
    assert "t4-sv": special_unit(Sievert, "dose equivalent", "Sv") { }
    assert "t4-kat": special_unit(Katal, "catalytic activity", "kat") { }
}

