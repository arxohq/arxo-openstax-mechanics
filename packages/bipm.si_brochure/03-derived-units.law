@source(SI9_TABLE_4, SI9_TABLE_2)
relation registry_name(u: SiUnit, name: Text) kind empirical {
    label en official "the unit's name in the unit registry units.si — the symbol of Table 2 or Table 4, spelled as the registry spells it";
    label ru unofficial "имя единицы в реестре единиц units.si — символ таблицы 2 или 4 в написании реестра";
}

@source(SI9_TABLE_4, SI9_TABLE_2)
facts RegistryNames {
    label en official "registry names of the seven base units and of the units of Table 4 that the registry declares (radian, steradian and degree Celsius have none: dimension one, and an interval scale)";
    label ru unofficial "имена в реестре семи базовых единиц и тех единиц таблицы 4, которые реестр объявляет (у радиана, стерадиана и градуса Цельсия имени нет: размерность один и интервальная шкала)";
    assert "rn-s": registry_name(Second, "s") { }
    assert "rn-m": registry_name(Metre, "m") { }
    assert "rn-kg": registry_name(Kilogram, "kg") { }
    assert "rn-a": registry_name(Ampere, "A") { }
    assert "rn-k": registry_name(Kelvin, "K") { }
    assert "rn-mol": registry_name(Mole, "mol") { }
    assert "rn-cd": registry_name(Candela, "cd") { }
    assert "rn-hz": registry_name(Hertz, "Hz") { }
    assert "rn-n": registry_name(Newton, "N") { }
    assert "rn-pa": registry_name(Pascal, "Pa") { }
    assert "rn-j": registry_name(Joule, "J") { }
    assert "rn-w": registry_name(Watt, "W") { }
    assert "rn-c": registry_name(Coulomb, "C_coulomb") { }
    assert "rn-v": registry_name(Volt, "V") { }
    assert "rn-f": registry_name(Farad, "F") { }
    assert "rn-ohm": registry_name(Ohm, "Ohm") { }
    assert "rn-si": registry_name(Siemens, "S") { }
    assert "rn-wb": registry_name(Weber, "Wb") { }
    assert "rn-t": registry_name(Tesla, "T") { }
    assert "rn-h": registry_name(Henry, "H") { }
    assert "rn-lm": registry_name(Lumen, "lm") { }
    assert "rn-lx": registry_name(Lux, "lx") { }
    assert "rn-bq": registry_name(Becquerel, "Hz") { }
    assert "rn-gy": registry_name(Gray, "Gy") { }
    assert "rn-sv": registry_name(Sievert, "Sv") { }
    assert "rn-kat": registry_name(Katal, "kat") { }
}

pub relation coherent_si_unit(u: SiUnit) kind institutional {
    label en official "§2.3.4: the unit belongs to the coherent set of SI units";
    label ru unofficial "§2.3.4: единица входит в когерентный набор единиц SI";
}

@source(SI9_S2_3_4_COHERENT, SI9_TABLE_2)
rule BaseUnitIsCoherent(u: SiUnit, q: BaseQuantity, s: Text) strict {
    label en official "§2.3.4: the base units belong to the coherent set of SI units";
    label ru unofficial "§2.3.4: базовые единицы входят в когерентный набор единиц SI";
    when base_unit(u, q, s);
    then coherent_si_unit(u);
}

@source(SI9_S2_3_4_SPECIAL_NAMES, SI9_TABLE_4)
rule SpecialNamedUnitIsCoherent(u: SiUnit, qn: Text, s: Text) strict {
    label en official "§2.3.4: the 22 units with special names are coherent derived units";
    label ru unofficial "§2.3.4: 22 единицы со специальными названиями — когерентные производные единицы";
    when special_unit(u, qn, s);
    then coherent_si_unit(u);
}

pub relation si_unit(u: SiUnit) kind institutional {
    label en official "the unit is an SI unit";
    label ru unofficial "единица есть единица SI";
}

@source(SI9_S2_3_4_COMPLETE_SET)
rule CoherentUnitIsSiUnit(u: SiUnit) strict {
    label en official "§2.3.4: the complete set of SI units includes the coherent set";
    label ru unofficial "§2.3.4: полный набор единиц SI включает когерентный набор";
    when coherent_si_unit(u);
    then si_unit(u);
}
