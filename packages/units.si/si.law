pub derived unit mm_per_day = mm / day;
@requires_feature("law.units/0.1")
pub derived unit mm_per_h = mm / h;
@requires_feature("law.units/0.1")
pub derived unit mm_per_s = mm / s;
@requires_feature("law.units/0.1")
pub derived unit mmol_per_l = mmol / l;
@requires_feature("law.units/0.1")
pub derived unit mol_per_kg = mol / kg;
@requires_feature("law.units/0.1")
pub derived unit mol_per_l = mol / l;
@requires_feature("law.units/0.1")
pub unit alias molar = mol_per_l;
@requires_feature("law.units/0.1")
pub derived unit mol_per_m3 = mol / m * m * m;
@requires_feature("law.units/0.1")
pub derived unit nJ = ug * m * m / s * s;
@requires_feature("law.units/0.1")
pub unit alias nanojoule = nJ;
@requires_feature("law.units/0.1")
pub derived unit nV = ug * m * m / s * s * s * A;
@requires_feature("law.units/0.1")
pub unit alias nanovolt = nV;
@requires_feature("law.units/0.1")
pub derived unit ng_per_ml = ng / ml;
@requires_feature("law.units/0.1")
pub derived unit pJ = ng * m * m / s * s;
@requires_feature("law.units/0.1")
pub unit alias picojoule = pJ;
@requires_feature("law.units/0.1")
pub derived unit per_m = 1 / m;
@requires_feature("law.units/0.1")
pub unit alias diopter = per_m;
@requires_feature("law.units/0.1")
pub unit alias dioptre = per_m;
@requires_feature("law.units/0.1")
pub derived unit per_mol = 1 / mol;
@requires_feature("law.units/0.1")
pub derived unit per_s = 1 / s;
@requires_feature("law.units/0.1")
pub derived unit t_km = t * km;
@requires_feature("law.units/0.1")
pub unit alias tonne_kilometre = t_km;
@requires_feature("law.units/0.1")
pub derived unit t_per_a = t / a_julian;
@requires_feature("law.units/0.1")
pub derived unit t_per_ha = t / ha;
@requires_feature("law.units/0.1")
pub derived unit uPa = g / km * s * s;
@requires_feature("law.units/0.1")
pub unit alias micropascal = uPa;
@requires_feature("law.units/0.1")
pub derived unit uS = s * s * s * A * A / kg * km * km;
@requires_feature("law.units/0.1")
pub unit alias microsiemens = uS;
@requires_feature("law.units/0.1")
pub derived unit uT = mg / s * s * A;
@requires_feature("law.units/0.1")
pub unit alias microtesla = uT;
@requires_feature("law.units/0.1")
pub derived unit uV = mg * m * m / s * s * s * A;
@requires_feature("law.units/0.1")
pub unit alias microvolt = uV;
@requires_feature("law.units/0.1")
pub derived unit ug_per_kg = ug / kg;
@requires_feature("law.units/0.1")
pub derived unit ug_per_l = ug / l;
@requires_feature("law.units/0.1")
pub derived unit umol_per_l = umol / l;
@requires_feature("law.units/0.1")
pub derived unit umol_per_min = umol / min;
@requires_feature("law.units/0.1")
pub unit alias enzyme_unit = umol_per_min;
@requires_feature("law.units/0.1")
pub derived unit mm3 = mm * mm * mm;
@requires_feature("law.units/0.1")
pub unit alias cubic_millimetre = mm3;
@requires_feature("law.units/0.1")
pub derived unit W_per_m_K = kg * m / s * s * s * K;
@requires_feature("law.units/0.1")
pub derived unit per_K = 1 / K;
@requires_feature("law.units/0.1")
pub unit alias reciprocal_kelvin = per_K;
@requires_feature("law.units/0.1")
pub derived unit m4 = m * m * m * m;
@requires_feature("law.units/0.1")
pub derived unit mm4 = mm * mm * mm * mm;

// --- Масштабированные атомы (§49.2, DECISION-0157) ---

// Стандартная атмосфера: точно 101325 Pa; определение 10-й CGPM (1954), резолюция 4, SI Brochure, приложение 1.
// https://www.bipm.org/en/committees/cg/cgpm/10-1954/resolution-4
@requires_feature("law.units/0.1")
pub unit atm = 101325 * Pa;
// Электронвольт: точно 1.602176634e-19 J через фиксированный элементарный заряд SI; SI Brochure, таблица 8.
// https://www.bipm.org/documents/20126/41483022/SI-Brochure-9.pdf
@requires_feature("law.units/0.1")
pub unit eV = (1602176634 / 10000000000000000000000000000) * J;
// Термохимическая калория: точно 4.184 J; не международная паровая калория cal_IT. NIST SP 811, сноски 9–10.
// https://www.nist.gov/pml/special-publication-811/nist-guide-si-footnotes
@requires_feature("law.units/0.1")
pub unit cal_th = (4184 / 1000) * J;
// Конвенциональный миллиметр ртутного столба: 0.001 m × 13595.1 kg/m³ × 9.80665 m/s² = точно 133.322387415 Pa; фиксированные конвенциональные плотность и стандартное ускорение, NIST SP 811, сноска 12 (ISO 80000-3). Не измеренная плотность и не Torr = atm/760.
// https://www.nist.gov/pml/special-publication-811/nist-guide-si-footnotes
@requires_feature("law.units/0.1")
pub unit mmHg = (133322387415 / 1000000000) * Pa;
// Метрическая лошадиная сила (л.с., PS, ch): точно 75 kgf·m/s = 75 × 9.80665 W = 735.49875 W через стандартное ускорение свободного падения; не механическая horsepower 745.699… W. NIST SP 811, приложение B.8, «horsepower (metric)».
// https://www.nist.gov/pml/special-publication-811/nist-guide-si-appendix-b-conversion-factors/nist-guide-si-appendix-b8
@requires_feature("law.units/0.1")
pub unit hp_metric = (73549875 / 100000) * W;
@requires_feature("law.units/0.1")
pub unit alias metric_horsepower = hp_metric;
// Международная (паровая) калория: точно 4.1868 J, Пятая международная конференция по свойствам пара (1956); не термохимическая cal_th = 4.184 J. NIST SP 811, приложение B.8, «calorie (International Table)».
// https://www.nist.gov/pml/special-publication-811/nist-guide-si-appendix-b-conversion-factors/nist-guide-si-appendix-b8
@requires_feature("law.units/0.1")
pub unit cal_IT = (41868 / 10000) * J;
@requires_feature("law.units/0.1")
pub unit alias calorie_IT = cal_IT;
// Гигакалория тепловых тарифов: точно 10^9 cal_IT = 4.1868 GJ; калория теплоснабжения — международная (паровая), а не термохимическая. NIST SP 811, приложение B.8.
// https://www.nist.gov/pml/special-publication-811/nist-guide-si-appendix-b-conversion-factors/nist-guide-si-appendix-b8
@requires_feature("law.units/0.1")
pub unit Gcal = 1000000000 * cal_IT;
@requires_feature("law.units/0.1")
pub unit alias gigacalorie = Gcal;
// Тройская унция драгоценных металлов: точно 480 гранов × 0.06479891 g = 31.1034768 g (международный фунт 1959 года — 0.45359237 kg = 7000 гранов). NIST SP 811, приложение B.8, «ounce (troy or apothecary)».
// https://www.nist.gov/pml/special-publication-811/nist-guide-si-appendix-b-conversion-factors/nist-guide-si-appendix-b8
@requires_feature("law.units/0.1")
pub unit troy_ounce = (311034768 / 10000000) * g;
@requires_feature("law.units/0.1")
pub unit alias oz_t = troy_ounce;
// Нефтяной баррель: точно 42 галлона США = 42 × 231 in³ при 1 in = 2.54 cm = 158.987294928 l. Перевод в массу (коэффициент баррелизации) зависит от плотности партии и остаётся фактом дела, не единицей. NIST SP 811, приложение B.8, «barrel [for petroleum, 42 gallons (U.S.)]».
// https://www.nist.gov/pml/special-publication-811/nist-guide-si-appendix-b-conversion-factors/nist-guide-si-appendix-b8
@requires_feature("law.units/0.1")
pub unit barrel = (158987294928 / 1000000000) * l;
@requires_feature("law.units/0.1")
pub unit alias bbl = barrel;
@requires_feature("law.units/0.1")
pub unit alias petroleum_barrel = barrel;
// Международная морская миля: точно 1852 m (Первая международная гидрографическая конференция, Монако, 1929). SI Brochure, 9-е издание, таблица 8.
// https://www.bipm.org/documents/20126/41483022/SI-Brochure-9.pdf
@requires_feature("law.units/0.1")
pub unit nmi = 1852 * m;
@requires_feature("law.units/0.1")
pub unit alias nautical_mile = nmi;
// Узел: точно одна морская миля в час = 1852/3600 m/s. SI Brochure, 9-е издание, таблица 8.
// https://www.bipm.org/documents/20126/41483022/SI-Brochure-9.pdf
@requires_feature("law.units/0.1")
pub unit knot = (1852 / 3600) * m_per_s;
@requires_feature("law.units/0.1")
pub unit alias kn = knot;
// Торр: точно 1/760 стандартной атмосферы = 101325/760 Pa ≈ 133.3224 Pa; отличается от конвенционального mmHg (133.322387415 Pa) на 1.5·10⁻⁷ относительных, и обе единицы держатся раздельно. NIST SP 811, приложение B.8, «torr».
// https://www.nist.gov/pml/special-publication-811/nist-guide-si-appendix-b-conversion-factors/nist-guide-si-appendix-b8
@requires_feature("law.units/0.1")
pub unit Torr = (101325 / 760) * Pa;
@requires_feature("law.units/0.1")
pub unit alias torr = Torr;
// Килограмм-сила: точно 9.80665 N через стандартное ускорение свободного падения (3-я CGPM, 1901). NIST SP 811, приложение B.8.
// https://www.nist.gov/pml/special-publication-811/nist-guide-si-appendix-b-conversion-factors/nist-guide-si-appendix-b8
@requires_feature("law.units/0.1")
pub unit kgf = (980665 / 100000) * N;
@requires_feature("law.units/0.1")
pub unit alias kilogram_force = kgf;
// Тонна-сила: точно 1000 kgf = 9806.65 N. NIST SP 811, приложение B.8 («ton-force (metric)»).
// https://www.nist.gov/pml/special-publication-811/nist-guide-si-appendix-b-conversion-factors/nist-guide-si-appendix-b8
@requires_feature("law.units/0.1")
pub unit tf = (980665 / 100) * N;
@requires_feature("law.units/0.1")
pub unit alias tonne_force = tf;
// Фунт-сила: точно 0.45359237 kg × 9.80665 m/s² = 4.4482216152605 N (международный фунт 1959 года и стандартное ускорение). NIST SP 811, приложение B.8.
// https://www.nist.gov/pml/special-publication-811/nist-guide-si-appendix-b-conversion-factors/nist-guide-si-appendix-b8
@requires_feature("law.units/0.1")
pub unit lbf = (44482216152605 / 10000000000000) * N;
@requires_feature("law.units/0.1")
pub unit alias pound_force = lbf;
// Фунт-сила на квадратный дюйм: точно lbf / in² = 4.4482216152605 N / 0.00064516 m² ≈ 6894.757293 Pa; дробь точная. NIST SP 811, приложение B.8.
// https://www.nist.gov/pml/special-publication-811/nist-guide-si-appendix-b-conversion-factors/nist-guide-si-appendix-b8
@requires_feature("law.units/0.1")
pub unit psi = (44482216152605 / 6451600000) * Pa;
@requires_feature("law.units/0.1")
pub unit alias pound_per_square_inch = psi;
// Кюри: точно 3.7×10¹⁰ Bq. NIST SP 811, приложение B.8.
// https://www.nist.gov/pml/special-publication-811/nist-guide-si-appendix-b-conversion-factors/nist-guide-si-appendix-b8
@requires_feature("law.units/0.1")
pub unit Ci = 37000000000 * Bq;
@requires_feature("law.units/0.1")
pub unit alias curie = Ci;
// Рад (поглощённая доза): точно 0.01 Gy. Имя `rad_dose`, чтобы не занимать `rad` радиана — углы за владельцем. NIST SP 811, приложение B.8.
// https://www.nist.gov/pml/special-publication-811/nist-guide-si-appendix-b-conversion-factors/nist-guide-si-appendix-b8
@requires_feature("law.units/0.1")
pub unit rad_dose = (1 / 100) * Gy;
// Бэр (эквивалентная доза): точно 0.01 Sv. NIST SP 811, приложение B.8.
// https://www.nist.gov/pml/special-publication-811/nist-guide-si-appendix-b-conversion-factors/nist-guide-si-appendix-b8
@requires_feature("law.units/0.1")
pub unit rem = (1 / 100) * Sv;
// Рентген (экспозиционная доза): точно 2.58×10⁻⁴ C/kg. NIST SP 811, приложение B.8.
// https://www.nist.gov/pml/special-publication-811/nist-guide-si-appendix-b-conversion-factors/nist-guide-si-appendix-b8
@requires_feature("law.units/0.1")
pub unit roentgen = (258 / 1000000) * C_per_kg;
@requires_feature("law.units/0.1")
pub unit alias R = roentgen;
// Пуаз (динамическая вязкость, СГС): точно 0.1 Pa·s. NIST SP 811, приложение B.8.
// https://www.nist.gov/pml/special-publication-811/nist-guide-si-appendix-b-conversion-factors/nist-guide-si-appendix-b8
@requires_feature("law.units/0.1")
pub unit poise = (1 / 10) * Pa_s;
// Стокс (кинематическая вязкость, СГС): точно 10⁻⁴ m²/s. NIST SP 811, приложение B.8.
// https://www.nist.gov/pml/special-publication-811/nist-guide-si-appendix-b-conversion-factors/nist-guide-si-appendix-b8
@requires_feature("law.units/0.1")
pub unit stokes = (1 / 10000) * m2_per_s;
@requires_feature("law.units/0.1")
pub unit alias St = stokes;
// Световой год: точно c × юлианский год = 299792458 m/s × 31557600 s = 9460730472580800 m (IAU: юлианский год и точная скорость света). Парсек не заводится — в его определении π.
// https://www.iau.org/public/themes/measuring/
@requires_feature("law.units/0.1")
pub unit ly = 9460730472580800 * m;
@requires_feature("law.units/0.1")
pub unit alias light_year = ly;
// Неделя как единица ВЕЛИЧИНЫ: точно 7 суток = 604800 s (ISO 80000-3). Не календарная единица срока §86 (`week` политики срока) — у той свой шаг и снимок §85.
// https://www.iso.org/standard/64974.html
@requires_feature("law.units/0.1")
pub unit wk = 7 * day;
@requires_feature("law.units/0.1")
pub unit alias week = wk;
// Международный дюйм: точно 25.4 mm (соглашение 1959 года). NIST SP 811, приложение B.8.
// https://www.nist.gov/pml/special-publication-811/nist-guide-si-appendix-b-conversion-factors/nist-guide-si-appendix-b8
@requires_feature("law.units/0.1")
pub unit inch = (254 / 10000) * m;
// Международный фут: точно 0.3048 m (12 дюймов; соглашение 1959 года). Не геодезический фут США. NIST SP 811, приложение B.8.
// https://www.nist.gov/pml/special-publication-811/nist-guide-si-appendix-b-conversion-factors/nist-guide-si-appendix-b8
@requires_feature("law.units/0.1")
pub unit ft = (3048 / 10000) * m;
@requires_feature("law.units/0.1")
pub unit alias foot = ft;
// Международный ярд: точно 0.9144 m (соглашение 1959 года). NIST SP 811, приложение B.8.
// https://www.nist.gov/pml/special-publication-811/nist-guide-si-appendix-b-conversion-factors/nist-guide-si-appendix-b8
@requires_feature("law.units/0.1")
pub unit yd = (9144 / 10000) * m;
@requires_feature("law.units/0.1")
pub unit alias yard = yd;
// Международная (уставная) миля: точно 1609.344 m = 5280 международных футов. Не морская миля `nmi`. NIST SP 811, приложение B.8.
// https://www.nist.gov/pml/special-publication-811/nist-guide-si-appendix-b-conversion-factors/nist-guide-si-appendix-b8
@requires_feature("law.units/0.1")
pub unit mi = (1609344 / 1000) * m;
@requires_feature("law.units/0.1")
pub unit alias mile = mi;
@requires_feature("law.units/0.1")
pub unit alias statute_mile = mi;
// Международный фунт (avoirdupois): точно 0.45359237 kg (соглашение 1959 года). NIST SP 811, приложение B.8.
// https://www.nist.gov/pml/special-publication-811/nist-guide-si-appendix-b-conversion-factors/nist-guide-si-appendix-b8
@requires_feature("law.units/0.1")
pub unit lb = (45359237 / 100000000) * kg;
@requires_feature("law.units/0.1")
pub unit alias pound = lb;
// Унция avoirdupois: точно lb/16 = 28.349523125 g. Не тройская `troy_ounce`. NIST SP 811, приложение B.8.
// https://www.nist.gov/pml/special-publication-811/nist-guide-si-appendix-b-conversion-factors/nist-guide-si-appendix-b8
@requires_feature("law.units/0.1")
pub unit oz = (28349523125 / 1000000000) * g;
@requires_feature("law.units/0.1")
pub unit alias ounce = oz;
// Галлон США (жидкостный): точно 231 in³ = 3.785411784 l. NIST SP 811, приложение B.8.
// https://www.nist.gov/pml/special-publication-811/nist-guide-si-appendix-b-conversion-factors/nist-guide-si-appendix-b8
@requires_feature("law.units/0.1")
pub unit gallon_US = (3785411784 / 1000000000) * l;
@requires_feature("law.units/0.1")
pub unit alias gal_US = gallon_US;
// Имперский галлон (Великобритания, Канада): точно 4.54609 l (Weights and Measures Act 1985). NIST SP 811, приложение B.8.
// https://www.nist.gov/pml/special-publication-811/nist-guide-si-appendix-b-conversion-factors/nist-guide-si-appendix-b8
@requires_feature("law.units/0.1")
pub unit gallon_UK = (454609 / 100000) * l;
@requires_feature("law.units/0.1")
pub unit alias gal_UK = gallon_UK;
@requires_feature("law.units/0.1")
pub unit alias imperial_gallon = gallon_UK;
// Бушель США (Winchester): точно 2150.42 in³ = 35.23907016688 l. Имперский бушель (36.36872 l) не заводится до спроса. NIST SP 811, приложение B.8.
// https://www.nist.gov/pml/special-publication-811/nist-guide-si-appendix-b-conversion-factors/nist-guide-si-appendix-b8
@requires_feature("law.units/0.1")
pub unit bushel_US = (3523907016688 / 100000000000) * l;
@requires_feature("law.units/0.1")
pub unit alias bu_US = bushel_US;
// Международный акр: точно 4840 yd² = 4046.8564224 m² по международному ярду 1959 года; акр по геодезическому футу США (4046.873 m²) не заводится — геодезический фут упразднён с 2023 года. NIST SP 811, приложение B.8.
// https://www.nist.gov/pml/special-publication-811/nist-guide-si-appendix-b-conversion-factors/nist-guide-si-appendix-b8
@requires_feature("law.units/0.1")
pub unit acre = (40468564224 / 10000000) * m2;
