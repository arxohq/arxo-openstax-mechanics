// m58321 «Types of Collisions» — fs-id1167131501190, ПРЕЖНЯЯ редакция
fragment UP_M58321_PERFECTLY_INELASTIC_PRIOR in M58321_PRIOR {
    kind defn;
    locator "module/m58321#fs-id1167131501190";
    text en official """<definition id="fs-id1167131501190">
<term>perfectly inelastic</term>
<meaning id="fs-id1167134507564">collision after which all objects are motionless, the final kinetic energy is zero, and the loss of kinetic energy is a maximum</meaning>
</definition>""";
    content_hash "sha256:bbe5137d7d75122a688fb02d8dd9835a33877d256ac72ff78f7f373944fbb1b4";
}

// m58719 «Work» — fs-id1165039354076
fragment UP_M58719_WORK in M58719_MAIN {
    kind defn;
    locator "module/m58719#fs-id1165039354076";
    text en official """<definition id="fs-id1165039354076">
<term>work</term>
<meaning id="fs-id1165035663968">done when a force acts on something that undergoes a displacement from one position to another</meaning>
</definition>""";
    content_hash "sha256:0cfb757360444a5687d20cddd6bb45117d3979a8b4ea382ca04de64e4fd8db98";
}

// m58308 «Kinetic Energy» — fs-id1165036767566
fragment UP_M58308_KINETIC_ENERGY in M58308_MAIN {
    kind defn;
    locator "module/m58308#fs-id1165036767566";
    text en official """<definition id="fs-id1165036767566">
<term>kinetic energy</term>
<meaning id="fs-id1165038247619">energy of motion, one-half an object’s mass times the square of its speed</meaning>
</definition>""";
    content_hash "sha256:556f651d98ea8423fd94cbec674057993c0e81a81b810aebd494a9c72ebf7aef";
}

// m58309 «Work-Energy Theorem» — fs-id1165038306067
fragment UP_M58309_WORK_ENERGY_THEOREM in M58309_MAIN {
    kind defn;
    locator "module/m58309#fs-id1165038306067";
    text en official """<definition id="fs-id1165038306067">
<term>work-energy theorem</term>
<meaning id="fs-id1165037270191">net work done on a particle is equal to the change in its kinetic energy</meaning>
</definition>""";
    content_hash "sha256:54f8ed276b48b06b63cd1e3f3f0c63bd33c8479205f3a98eb58185d6d05556d5";
}

// m58309 «Work-Energy Theorem» — fs-id1165036884203
fragment UP_M58309_THEOREM_STATEMENT in M58309_MAIN {
    kind section;
    locator "module/m58309#fs-id1165036884203";
    text en official """<note id="fs-id1165036884203">
<title>Work-Energy Theorem</title>
<para id="fs-id1165036972359">The net work done on a particle equals the change in the particle’s kinetic energy:</para>
<equation id="fs-id1165037940073"><m:math><m:mrow><m:msub><m:mi>W</m:mi><m:mrow><m:mtext>net</m:mtext></m:mrow></m:msub><m:mo>=</m:mo><m:msub><m:mi>K</m:mi><m:mi>B</m:mi></m:msub><m:mo>−</m:mo><m:msub><m:mi>K</m:mi><m:mi>A</m:mi></m:msub><m:mo>.</m:mo></m:mrow></m:math>
</equation>
</note>""";
    content_hash "sha256:f108debdca7f4be90b356154ea60921abcc1089d0adabc41def40ef6e8be96d8";
}

// m58310 «Power» — fs-id1165038026773
fragment UP_M58310_AVERAGE_POWER in M58310_MAIN {
    kind defn;
    locator "module/m58310#fs-id1165038026773";
    text en official """<definition id="fs-id1165038026773">
<term>average power</term>
<meaning id="fs-id1165036771180">work done in a time interval divided by the time interval</meaning>
</definition>""";
    content_hash "sha256:ae987d52d74ed44ff73f4a4121dd3cee95150f1c2605899bcce5a010fead72c5";
}

// m58313 «Conservative and Non-Conservative Forces» — fs-id1165039295908
fragment UP_M58313_CONSERVATIVE_FORCE in M58313_MAIN {
    kind defn;
    locator "module/m58313#fs-id1165039295908";
    text en official """<definition id="fs-id1165039295908">
<term>conservative force</term>
<meaning id="fs-id1165035706005">force that does work independent of path</meaning>
</definition>""";
    content_hash "sha256:6da0f41bc61462dc5b46016db884c50a06da88f444eedcefb29063a4f26f7a24";
}

// m58313 «Conservative and Non-Conservative Forces» — fs-id1165039477062
fragment UP_M58313_NON_CONSERVATIVE_FORCE in M58313_MAIN {
    kind defn;
    locator "module/m58313#fs-id1165039477062";
    text en official """<definition id="fs-id1165039477062">
<term>non-conservative force</term>
<meaning id="fs-id1165039052463">force that does work that depends on path</meaning>
</definition>""";
    content_hash "sha256:e6747327c01e51cec70998be552cdef6523258b0d0da877613f566840a0a67f8";
}

// m58314 «Conservation of Energy» — fs-id1165038016114
fragment UP_M58314_MECHANICAL_ENERGY in M58314_MAIN {
    kind defn;
    locator "module/m58314#fs-id1165038016114";
    text en official """<definition id="fs-id1165038016114">
<term>mechanical energy</term>
<meaning id="fs-id1165037047747">sum of the kinetic and potential energies</meaning>
</definition>""";
    content_hash "sha256:0ba3d4e6e06e5cf3fdda2e1630bafe1453cca9dc3c16fde233e0ee0a133946c0";
}

// m58314 «Conservation of Energy» — fs-id1165038024912
fragment UP_M58314_ENERGY_CONSERVATION in M58314_MAIN {
    kind defn;
    locator "module/m58314#fs-id1165038024912";
    text en official """<definition id="fs-id1165038024912">
<term>energy conservation</term>
<meaning id="fs-id1165037181302">total energy of an isolated system is constant</meaning>
</definition>""";
    content_hash "sha256:ed05226683ccf398605f08fa15403f1187f8520aca4dd00500ca90279b8484a0";
}

// m58318 «Linear Momentum» — fs-id1167133546182
fragment UP_M58318_MOMENTUM in M58318_MAIN {
    kind defn;
    locator "module/m58318#fs-id1167133546182";
    text en official """<definition id="fs-id1167133546182">
<term>momentum</term>
<meaning id="fs-id1167133532866">measure of the quantity of motion that an object has; it takes into account both how fast the object is moving, and its mass; specifically, it is the product of mass and velocity; it is a vector quantity</meaning>
</definition>""";
    content_hash "sha256:67d336d251c393f8a56aa81b8fb76d61d4bdd5a9fa387d21fcebe58b9edadf6b";
}

// m58320 «Conservation of Linear Momentum» — fs-id1167131257470
fragment UP_M58320_SYSTEM in M58320_MAIN {
    kind defn;
    locator "module/m58320#fs-id1167131257470";
    text en official """<definition id="fs-id1167131257470">
<term>system</term>
<meaning id="fs-id1167131586212">object or collection of objects whose motion is currently under investigation; however, your system is defined at the start of the problem, you must keep that definition for the entire problem</meaning>
</definition>""";
    content_hash "sha256:a9e8d622b22f07eae04b3ea01cfcaf132e1b8427522e7eb04c78b4eb354e2ebe";
}

// m58320 «Conservation of Linear Momentum» — fs-id1167134928870
fragment UP_M58320_CLOSED_SYSTEM in M58320_MAIN {
    kind defn;
    locator "module/m58320#fs-id1167134928870";
    text en official """<definition id="fs-id1167134928870">
<term>closed system</term>
<meaning id="fs-id1167131586266">system for which the mass is constant and the net external force on the system is zero</meaning>
</definition>""";
    content_hash "sha256:a3864c470c780bd185f0364cc3c2653c046a75e9fbc37e4d521d75ad183dfa99";
}

// m58320 «Conservation of Linear Momentum» — fs-id1167134540321
fragment UP_M58320_LAW_OF_CONSERVATION in M58320_MAIN {
    kind defn;
    locator "module/m58320#fs-id1167134540321";
    text en official """<definition id="fs-id1167134540321">
<term>Law of Conservation of Momentum</term>
<meaning id="fs-id1167134540326">total momentum of a closed system cannot change</meaning>
</definition>""";
    content_hash "sha256:c3d07c068c4c85c0b0c6f5fd768f74c572df25127186547e6cb05f93d1b0ac19";
}

// m58321 «Types of Collisions» — fs-id1167134866786
fragment UP_M58321_ELASTIC in M58321_MAIN {
    kind defn;
    locator "module/m58321#fs-id1167134866786";
    text en official """<definition id="fs-id1167134866786">
<term>elastic</term>
<meaning id="fs-id1167134570090">collision that conserves kinetic energy</meaning>
</definition>""";
    content_hash "sha256:6599809339c1c4f97bdd6fe4657eedb31d4bab2e2abbff92b34078731a914de0";
}

// m58321 «Types of Collisions» — fs-id1167131552107
fragment UP_M58321_INELASTIC in M58321_MAIN {
    kind defn;
    locator "module/m58321#fs-id1167131552107";
    text en official """<definition id="fs-id1167131552107">
<term>inelastic</term>
<meaning id="fs-id1167134942503">collision that does not conserve kinetic energy</meaning>
</definition>""";
    content_hash "sha256:a057b45563364b2ce8d71d75efd6758d23282907d2f89b03200a8b25b2deb289";
}

// m58321 «Types of Collisions» — fs-id1167131501190
fragment UP_M58321_PERFECTLY_INELASTIC in M58321_MAIN {
    kind defn;
    locator "module/m58321#fs-id1167131501190";
    text en official """<definition id="fs-id1167131501190">
<term>perfectly inelastic</term>
<meaning id="fs-id1167134507564">collision after which all objects are stuck together, moving with the same velocity; momentum is conserved, and the loss of kinetic energy is a maximum</meaning>
</definition>""";
    content_hash "sha256:41ba864dbcf742b8a9409335a21d855a7805591306759164d2cfc74d1f52d430";
}
