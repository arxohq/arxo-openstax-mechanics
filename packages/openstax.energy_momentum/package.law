// OpenStax University Physics, том 1, главы 7 «Work and Kinetic Energy»,
// 8 «Potential Energy and Conservation of Energy» и 9 «Linear Momentum and
// Collisions»: СОХРАНЕНИЕ как предмет.
//
// ЧТО ЭТО ЗА ПАКЕТ. Четвёртый слой. Динамика отвечала «какая сила»; здесь
// спрашивают иначе — «что осталось прежним». Сохранение есть утверждение
// УСЛОВНОЕ: импульс сохраняется в ЗАМКНУТОЙ системе, механическая энергия —
// при КОНСЕРВАТИВНЫХ силах, кинетическая энергия — в УПРУГОМ столкновении.
// Условие и есть содержание закона, и пакет устроен вокруг него: каждое
// сохранение имеет пару правил — выполняется при условии, ОПРОВЕРГАЕТСЯ при
// его нарушении.
//
// ПОЧЕМУ ЭТО ВАЖНЕЕ ФОРМУЛ. Ответ «импульс сохраняется» без названного
// условия бесполезен: сохраняется он не всегда. Система, которая на
// предъявленном случае говорит «нет, потому что на систему действует внешняя
// сила 12 Н» либо «да, потому что внешних сил не предъявлено, а система
// объявлена замкнутой», отвечает на вопрос, ради которого главы 8 и 9
// написаны. Отсюда `refuted` и отрицательная голова в каждом модуле.
//
// ЧТО ЛОЖИТСЯ И ЧТО НЕТ.
//   ложится   работа постоянной силы, кинетическая энергия, теорема о работе
//             и энергии, мощность, потенциальная энергия предъявленная,
//             механическая энергия как сумма, классификация сил на
//             консервативные и неконсервативные, импульс, изменение импульса,
//             сохранение импульса и энергии с условиями, классификация
//             столкновений на упругие, неупругие и абсолютно неупругие;
//   не ложится работа переменной силы (интеграл §7.1), потенциальная энергия
//             как первообразная силы (§8.1), центр масс системы точек как
//             сумма по неограниченному набору, реактивное движение §9.7
//             (дифференциальное уравнение). Дело предъявляет проинтегрированные
//             величины, пакет проверяет соотношения между ними.
//
// КАРТА МОДУЛЕЙ
//   01-work-energy         §7.1–7.4: работа, кинетическая энергия, теорема о
//                          работе и энергии, мощность
//   02-conservation-energy §8.2–8.3: консервативные силы, механическая
//                          энергия, сохранение энергии с условием
//   03-momentum-collisions §9.1–9.4: импульс, изменение импульса, сохранение
//                          импульса в замкнутой системе, упругие и неупругие
//                          столкновения
//   sources                провенанс: 19 закреплённых модулей CNXML

language "law.core" version "0.2";
package openstax.energy_momentum version "0.1.0";
namespace "urn:openstax:clir:energy-momentum";

import units.si version "0.1.0";
import bipm.si_brochure version "0.1.0";
import openstax.measurement version "0.1.0";
import openstax.kinematics version "0.1.0";
import openstax.dynamics version "0.1.0";

// Объект, несущий энергию и импульс. §9.3 отличает СИСТЕМУ (то, что охвачено
// границей) от тела внутри неё, и различение здесь существенно: импульс
// сохраняется у системы, а не у тела.
pub entity Object {
    label en official "a body carrying energy and momentum — one of the objects inside the system";
    label ru unofficial "тело, несущее энергию и импульс, — один из объектов внутри системы";
}

// Система §9.3: «a collection of objects whose interactions we study». Именно
// она замкнута или нет, и именно у неё сохраняется импульс.
pub entity Collection {
    label en official "§9.3: a system — a collection of objects whose mutual interactions are studied, and whose momentum may be conserved";
    label ru unofficial "§9.3: система — совокупность объектов, чьи взаимодействия рассматриваются и чей импульс может сохраняться";
}

// Процесс: столкновение, взрыв, перемещение под действием силы. Ему
// принадлежат «до» и «после», без которых сохранение бессмысленно.
pub entity Process {
    label en official "a process with a before and an after — a collision, an explosion, or a displacement under a force";
    label ru unofficial "процесс с состояниями «до» и «после» — столкновение, взрыв или перемещение под действием силы";
}
