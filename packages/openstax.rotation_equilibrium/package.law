// OpenStax University Physics, том 1, главы 10 «Fixed-Axis Rotation»,
// 11 «Angular Momentum», 12 «Static Equilibrium and Elasticity» и
// 13 «Gravitation»: ВРАЩЕНИЕ, РАВНОВЕСИЕ И ТЯГОТЕНИЕ.
//
// ЧТО ЭТО ЗА ПАКЕТ. Пятый слой и второй мост корпуса. Главы 10–11 повторяют
// динамику и сохранение для вращения — момент инерции вместо массы, момент
// силы вместо силы, момент импульса вместо импульса; глава 12 отвечает на
// вопрос «почему тело в равновесии» ДВУМЯ условиями сразу; глава 13 даёт
// закон тяготения и законы Кеплера.
//
// ДВА ПРОИЗВОДИТЕЛЯ ЗАКОНОВ КЕПЛЕРА — И ЭТО НЕ ПРОЧТЕНИЯ. Кеплер вывел свои
// законы ИЗ НАБЛЮДЕНИЙ Тихо Браге за полвека до «Начал»; Ньютон ВЫВЕЛ их из
// закона тяготения. Утверждение одно, оснований два, и они не спорят — они
// подтверждают друг друга. Поэтому здесь НЕ `interpretation_group`: у одной
// головы просто два правила, эмпирическое и выводное, и дело вправе опереться
// на любое или на оба. Прочтения понадобились второму закону Ньютона потому,
// что там формулировки РАСХОДЯТСЯ на переменной массе; здесь расхождения нет,
// и навязывать делу выбор было бы ложью о предмете.
//
// РАВНОВЕСИЕ ТРЕБУЕТ ДВУХ УСЛОВИЙ, И ОДНОГО МАЛО. §12.1 даёт первое
// (результирующая сила нулевая) и второе (результирующий момент нулевой) и
// подчёркивает независимость: тело с нулевой результирующей силой и
// ненулевым моментом вращается. Пакет держит оба порознь и выводит
// равновесие лишь при обоих — сцена 03c показывает случай, где выполнено
// первое и не выполнено второе.
//
// ГРАНИЦА. Момент инерции ВЫЧИСЛЯЕТСЯ интегрированием по телу (§10.5), и
// этого в языке нет: дело предъявляет момент инерции, а пакет проверяет
// соотношения. Прецессия §11.4, тензор инерции и упругие модули §12.3
// требуют либо интеграла, либо тензорной алгебры — не взяты, и это граница
// ЯЗЫКА, названная в лоб.
//
// КАРТА МОДУЛЕЙ
//   01-rotation          §10.4–10.7: момент инерции, вращательная
//                        кинетическая энергия, момент силы, второй закон
//                        для вращения
//   02-angular-momentum  §11.2–11.3: момент импульса, его сохранение
//   03-equilibrium       §12.1: два условия статического равновесия
//   04-gravitation       §13.1, §13.5: закон тяготения, законы Кеплера
//                        двумя производителями
//   sources              провенанс: 27 закреплённых модулей CNXML

language "law.core" version "0.2";
package openstax.rotation_equilibrium version "0.1.0";
namespace "urn:openstax:clir:rotation-equilibrium";

import units.si version "0.1.0";
import bipm.si_brochure version "0.1.0";
import openstax.measurement version "0.1.0";
import openstax.kinematics version "0.1.0";
import openstax.dynamics version "0.1.0";
import openstax.energy_momentum version "0.1.0";

// Вращающееся тело: у него есть ось, момент инерции и угловая скорость.
pub entity RigidBody {
    label en official "a rigid body rotating about a fixed axis, with a moment of inertia and an angular velocity";
    label ru unofficial "твёрдое тело, вращающееся вокруг закреплённой оси, с моментом инерции и угловой скоростью";
}

// Небесное тело главы 13: у него есть масса, и оно обращается вокруг другого.
pub entity CelestialBody {
    label en official "§13: a celestial body — one that attracts others by gravitation and may orbit another";
    label ru unofficial "§13: небесное тело — притягивающее другие тяготением и, возможно, обращающееся вокруг другого";
}
