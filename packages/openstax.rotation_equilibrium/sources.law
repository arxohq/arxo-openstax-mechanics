// m58329 «Moment of Inertia and Rotational Kinetic Energy» — fs-id1167132283419
fragment UP_M58329_MOMENT_OF_INERTIA in M58329_MAIN {
    kind defn;
    locator "module/m58329#fs-id1167132283419";
    text en official """<definition id="fs-id1167132283419">
<term>moment of inertia</term>
<meaning id="fs-id1167132283425">rotational mass of rigid bodies that relates to how easy or hard it will be to change the angular velocity of the rotating rigid body</meaning>
</definition>""";
    content_hash "sha256:5a9924139b0f0e834f712e312a09398ce8611d671ead2c21b78e3ac073fa1ef1";
}

// m58329 «Moment of Inertia and Rotational Kinetic Energy» — fs-id1167132283430
fragment UP_M58329_ROTATIONAL_KINETIC_ENERGY in M58329_MAIN {
    kind defn;
    locator "module/m58329#fs-id1167132283430";
    text en official """<definition id="fs-id1167132283430">
<term>rotational kinetic energy</term>
<meaning id="fs-id1167132205291">kinetic energy due to the rotation of an object; this is part of its total kinetic energy</meaning>
</definition>""";
    content_hash "sha256:e2dc42abddb8cf926538feb662b5d75a9af79fc94eae28264044c51d565c7d61";
}

// m58331 «Torque» — fs-id1167133606821
fragment UP_M58331_TORQUE in M58331_MAIN {
    kind defn;
    locator "module/m58331#fs-id1167133606821";
    text en official """<definition id="fs-id1167133606821">
<term>torque</term>
<meaning id="fs-id1167132306479">cross product of a force and a lever arm to a given axis</meaning>
</definition>""";
    content_hash "sha256:b105674f6ccf51d226ca2c674d04f3b6a122fb47b171cd4d109b643ac6a38bba";
}

// m58331 «Torque» — fs-id1167132312261
fragment UP_M58331_LEVER_ARM in M58331_MAIN {
    kind defn;
    locator "module/m58331#fs-id1167132312261";
    text en official """<definition id="fs-id1167132312261">
<term>lever arm</term>
<meaning id="fs-id1167133606817">perpendicular distance from the line that the force vector lies on to a given axis</meaning>
</definition>""";
    content_hash "sha256:935d1a9254021b559ce84492673472633e780140c82a4b5004691f27d52e0195";
}

// m58332 «Newton's Second Law for Rotation» — fs-id1167131118823
fragment UP_M58332_SECOND_LAW_ROTATION in M58332_MAIN {
    kind defn;
    locator "module/m58332#fs-id1167131118823";
    text en official """<definition id="fs-id1167131118823">
<term>Newton’s second law for rotation</term>
<meaning id="fs-id1167131118830">sum of the torques on a rotating system equals its moment of inertia times its angular acceleration</meaning>
</definition>""";
    content_hash "sha256:08384342359e106385c3caa5faf49578c0d4c21338b131aaf3535d1a03a7c883";
}

// m58332 «Newton's Second Law for Rotation» — fs-id1167134886602
fragment UP_M58332_SECOND_LAW_ROTATION_STATEMENT in M58332_MAIN {
    kind section;
    locator "module/m58332#fs-id1167134886602";
    text en official """<note id="fs-id1167134886602">
<title>Newton’s Second Law for Rotation</title>
<para id="fs-id1167134511100">If more than one torque acts on a rigid body about a fixed axis, then the sum of the torques equals the moment of inertia times the angular acceleration:</para>
<equation id="fs-id1167134508536"><m:math><m:mrow><m:msub><m:mi>τ</m:mi><m:mi>net</m:mi></m:msub><m:mo>=</m:mo><m:mstyle displaystyle="true"><m:munder><m:mo>∑</m:mo><m:mi>i</m:mi></m:munder><m:mrow><m:msub><m:mi>τ</m:mi><m:mi>i</m:mi></m:msub></m:mrow></m:mstyle><m:mo>=</m:mo><m:mi>I</m:mi><m:mi>α</m:mi><m:mo>.</m:mo></m:mrow></m:math></equation>
</note>""";
    content_hash "sha256:8981b90b2c50c780b6f971a1b2173e398ba03b95a48d2d21521de354406cb9c3";
}

// m58336 «Angular Momentum» — fs-id1165037215309
fragment UP_M58336_ANGULAR_MOMENTUM in M58336_MAIN {
    kind defn;
    locator "module/m58336#fs-id1165037215309";
    text en official """<definition id="fs-id1165037215309"><term>angular momentum</term>
<meaning id="fs-id1165037215313">rotational analog of linear momentum, found by taking the product of moment of inertia and angular velocity</meaning>
</definition>""";
    content_hash "sha256:f2aca482bece64f504ae14b62558034d252a1795d9651367dfc8dfa5c74e4846";
}

// m58337 «Conservation of Angular Momentum» — fs-id1165037004448
fragment UP_M58337_CONSERVATION_OF_ANGULAR_MOMENTUM in M58337_MAIN {
    kind defn;
    locator "module/m58337#fs-id1165037004448";
    text en official """<definition id="fs-id1165037004448">
<term>law of conservation of angular momentum</term>
<meaning id="fs-id1165037075507">angular momentum is conserved, that is, the initial angular momentum is equal to the final angular momentum when no external torque is applied to the system</meaning>
</definition>""";
    content_hash "sha256:75822048d59bb732de1630375973905c0d9a9611f6e3243307f60fc977e42023";
}

// m58340 «Conditions for Static Equilibrium» — fs-id1163713557656
fragment UP_M58340_EQUILIBRIUM in M58340_MAIN {
    kind defn;
    locator "module/m58340#fs-id1163713557656";
    text en official """<definition id="fs-id1163713557656">
<term>equilibrium</term>
<meaning id="fs-id1163713525583">body is in equilibrium when its linear and angular accelerations are both zero relative to an inertial frame of reference</meaning>
</definition>""";
    content_hash "sha256:e5eacdf2a4774598df78d58cf8e8e08886fcad7a1d62f98a9ddc3880858ea255";
}

// m58340 «Conditions for Static Equilibrium» — fs-id1163709774761
fragment UP_M58340_STATIC_EQUILIBRIUM in M58340_MAIN {
    kind defn;
    locator "module/m58340#fs-id1163709774761";
    text en official """<definition id="fs-id1163709774761">
<term>static equilibrium</term>
<meaning id="fs-id1163713276572">body is in static equilibrium when it is at rest in our selected inertial frame of reference</meaning>
</definition>""";
    content_hash "sha256:e1107c82aa34404ba991a8e79f2fd90f147f0280469ebe97ce2be5c263e48221";
}

// m58340 «Conditions for Static Equilibrium» — fs-id1163713530656
fragment UP_M58340_FIRST_EQUILIBRIUM_CONDITION in M58340_MAIN {
    kind defn;
    locator "module/m58340#fs-id1163713530656";
    text en official """<definition id="fs-id1163713530656">
<term>first equilibrium condition</term>
<meaning id="fs-id1163713428816">expresses translational equilibrium; all external forces acting on the body balance out and their vector sum is zero</meaning>
</definition>""";
    content_hash "sha256:cccec8d304b4476604f711225f79add3461a3a38120ee37903bdca6d62e95322";
}

// m58340 «Conditions for Static Equilibrium» — fs-id1163709759627
fragment UP_M58340_SECOND_EQUILIBRIUM_CONDITION in M58340_MAIN {
    kind defn;
    locator "module/m58340#fs-id1163709759627";
    text en official """<definition id="fs-id1163709759627">
<term>second equilibrium condition</term>
<meaning id="fs-id1163709750024">expresses rotational equilibrium; all torques due to external forces acting on the body balance out and their vector sum is zero</meaning>
</definition>""";
    content_hash "sha256:67cd9f0376c08786b96253b2f9bfe5a8fa85a7d4165596b9d8db63b194ec47d8";
}

// m58345 «Newton's Law of Universal Gravitation» — fs-id1168328193986
fragment UP_M58345_LAW_OF_GRAVITATION in M58345_MAIN {
    kind defn;
    locator "module/m58345#fs-id1168328193986";
    text en official """<definition id="fs-id1168328193986">
<term>Newton’s law of gravitation</term>
<meaning id="fs-id1168327988168">every mass attracts every other mass with a force proportional to the product of their masses, inversely proportional to the square of the distance between them, and with direction along the line connecting the center of mass of each</meaning>
</definition>""";
    content_hash "sha256:de88a69a76312a8bfc6931e64e43d9574f8e1a86d0f6e828bc7d6a56b7eb7e4b";
}

// m58345 «Newton's Law of Universal Gravitation» — fs-id1168328252700
fragment UP_M58345_GRAVITATIONAL_CONSTANT in M58345_MAIN {
    kind defn;
    locator "module/m58345#fs-id1168328252700";
    text en official """<definition id="fs-id1168328252700">
<term>universal gravitational constant</term>
<meaning id="fs-id1168328252706">constant representing the strength of the gravitational force, that is believed to be the same throughout the universe</meaning>
</definition>""";
    content_hash "sha256:37c65123149d74dd150c107e42b3f7f115d26ac781979e88e1c2edfff7ce5875";
}

// m58350 «Kepler's Laws of Planetary Motion» — fs-id1168329517229
fragment UP_M58350_KEPLER_FIRST_LAW in M58350_MAIN {
    kind defn;
    locator "module/m58350#fs-id1168329517229";
    text en official """<definition id="fs-id1168329517229">
<term>Kepler’s first law</term>
<meaning id="fs-id1168326765861">law stating that every planet moves along an ellipse, with the Sun located at a focus of the ellipse</meaning>
</definition>""";
    content_hash "sha256:c02d8a5e97cfeb611d539bcb8a802e7d38f8ed7714a6ce4903a5e1772fdc6b9e";
}

// m58350 «Kepler's Laws of Planetary Motion» — fs-id1168326790250
fragment UP_M58350_KEPLER_SECOND_LAW in M58350_MAIN {
    kind defn;
    locator "module/m58350#fs-id1168326790250";
    text en official """<definition id="fs-id1168326790250">
<term>Kepler’s second law</term>
<meaning id="fs-id1168329461373">law stating that a planet sweeps out equal areas in equal times, meaning it has a constant areal velocity</meaning>
</definition>""";
    content_hash "sha256:8acfee16a206f15031be4cbc7ce3a124b2f74641b7184fb91ff69c8a9d3b08a4";
}

// m58350 «Kepler's Laws of Planetary Motion» — fs-id1168329137868
fragment UP_M58350_KEPLER_THIRD_LAW in M58350_MAIN {
    kind defn;
    locator "module/m58350#fs-id1168329137868";
    text en official """<definition id="fs-id1168329137868">
<term>Kepler’s third law</term>
<meaning id="fs-id1168329188942">law stating that the square of the period is proportional to the cube of the semi-major axis of the orbit</meaning>
</definition>""";
    content_hash "sha256:dd45350d7d3755d93ff6416ff2bb378c81d9c0ea4d3e560d2904b29d95b85728";
}
