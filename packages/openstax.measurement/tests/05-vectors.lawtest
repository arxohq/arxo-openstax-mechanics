        assert "t05k-r": vector_length(entity_ref("urn:case:meas:vec:p"), 10 m) { origin case_input; }
        assert "t05k-th": direction_angle_degrees(entity_ref("urn:case:meas:vec:p"), 35.0) { origin case_input; }
    }

    evaluate truth(component_from_direction(entity_ref("urn:case:meas:vec:p"), "y", 5.736 m));

    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    expect applied(YComponentFromDirection);
}
