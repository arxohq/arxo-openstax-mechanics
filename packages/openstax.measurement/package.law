// OpenStax University Physics, том 1, главы 1 «Units and Measurement» и 2
// «Vectors»: словарь измерения как ПЕРВЫЙ СЛОЙ классической физики поверх
// корня метрологии.
//
// ЧТО ЭТО ЗА ПАКЕТ. Нижняя ступень цепочки «измерение → кинематика →
// динамика → сохранение». Свои термины — физическая величина, измерение,
// размерность, размерная согласованность, значащие цифры, точность и
// правильность, вектор и его компоненты. Всё, что касается САМИХ ЕДИНИЦ,
// читается из двух зависимостей и не заводится заново:
//
//   `bipm.si_brochure` — НОРМАТИВНОЕ имя единицы. Учебник говорит «kilogram:
//       SI unit for mass, abbreviated kg» и на этом останавливается; ЧЕМ
//       килограмм определён (постоянной Планка с 20.05.2019, прототипом до
//       того), говорит брошюра SI. Поэтому `SiUnit`, `BaseQuantity`,
//       `base_unit`, `special_unit`, `si_unit`, `base_exponent` — оттуда
//       квалифицированными именами.
//   `units.si` — СЧЁТ над величиной. Импорт не тянет ни одного символа: он
//       предъявляет реестр §49.2, по которому `magnitude` разрешает теги
//       (m, s, kg, m_per_s, m_per_s2, N, J, W…). Без него переход отвечает
//       UNIT_UNKNOWN, а не берёт умолчание.
//
// ДВЕ ГРОМКОСТИ РАЗМЕРНОСТИ — И ОБЕ НУЖНЫ. §1.4 учебника проверяет формулу
// СИМВОЛЬНО: «[s] = L, [v] = LT⁻¹», и вывод «не согласована» есть вывод, а не
// отказ вычислителя. Алгебра §49.1 (DECISION-0154) проверяет ЗНАЧЕНИЕ и на
// чужой размерности отказывает громко. Пакет держит обе:
//
//   символьная  модуль 02: показатели по базовым величинам сравниваются
//               целыми; расхождение — ВЫВОД `terms_differ_in`, отсюда
//               `not dimensionally_consistent` (FALSE_ONLY) и `why_not`;
//   значимая    модуль 02, вторая половина: предъявленный ответ сверяется
//               с произведением величин; чужая единица — отказ алгебры с
//               названной причиной, а не тихое «не выведено».
//
// Первая отвечает на «почему эта формула бессмысленна», вторая — на «почему
// это число не может быть ответом». Ни одна не заменяет другую: символьная
// не видит масштаба (км против м — одна размерность), значимая не работает
// без предъявленных чисел.
//
// ГРАНИЦА. Векторная алгебра §2.2–2.4 взята КЛАССИФИКАЦИЯМИ и сравнением
// предъявленных компонент: сумма, разность, скалярное и векторное
// произведение требуют корня и тригонометрии, которых в языке нет (§46 без
// циклов, §58 без sqrt/sin). Дело предъявляет компоненты и угол, пакет
// проверяет равенство, параллельность, ортогональность и нулевой вектор.
// Оценки Ферми §1.5 и «решение задач» §1.7 не формализуются: это методика,
// а не утверждения о мире.
//
// ЧТО ЭКСПОРТИРУЕТСЯ. Словарь измерения — корень цепочки физики, и
// сущности `Measurement`, `Equation`, `Term`, `Vector` вместе с выводами
// §1.4 о размерной согласованности уходят наружу: на них ссылаются все
// пакеты выше. Предъявляемые делом факты остаются внутренними по тому же
// доводу, что и в кинематике.
//
// КАРТА МОДУЛЕЙ
//   01-quantities   §1.2–1.3: физическая величина, базовая и производная,
//                   единица измерения, коэффициент пересчёта; мост к брошюре
//   02-dimensions   §1.4: размерность, размерная согласованность обеими
//                   громкостями, «несогласованная формула не может быть
//                   законом природы»
//   03-uncertainty  §1.6: значащие цифры, погрешность, точность против
//                   правильности, расхождение
//   04-vectors      §2.1–2.3: скаляр и вектор, компоненты, равенство,
//                   параллельность, ортогональность, нулевой вектор
//   sources         провенанс: 13 закреплённых модулей CNXML, фрагменты по
//                   идентификаторам элементов

language "law.core" version "0.2";
package openstax.measurement version "0.1.0";
namespace "urn:openstax:clir:measurement";

import units.si version "0.1.0";
import bipm.si_brochure version "0.1.0";

// Измерение — то, что дело предъявляет: величина с единицей плюс сказанное о
// ней (что именно измерено, в какой единице записано, сколько значащих цифр).
// Это НЕ само число: одно и то же число, названное измерением длины и
// измерением времени, есть два разных измерения.
pub entity Measurement {
    label en official "a measurement presented by the case: a physical quantity together with what is said about it";
    label ru unofficial "измерение, предъявленное делом: физическая величина вместе со сказанным о ней";
}

// Уравнение §1.4 — предъявленное делом равенство физических величин, о
// котором спрашивают, может ли оно быть законом природы.
pub entity Equation {
    label en official "an equation between physical quantities presented by the case for a dimensional check";
    label ru unofficial "предъявленное делом равенство физических величин — предмет проверки на размерность";
}

// Терм уравнения — то, что складывается и приравнивается. §1.4: «every term
// in an expression must have the same dimensions».
pub entity Term {
    label en official "a term of a presented equation: one of the expressions added, subtracted or equated";
    label ru unofficial "терм предъявленного уравнения: одно из складываемых, вычитаемых или приравниваемых выражений";
}

// Вектор главы 2 — предъявленный делом объект с величиной и направлением.
pub entity Vector {
    label en official "a vector presented by the case: a quantity with magnitude and direction";
    label ru unofficial "предъявленный делом вектор: величина с направлением";
}
